{"chapter": 69, "verses": [{"chapter": 69, "verse": 1, "text": "اَ۬لْحَآقَّةُ مَا اَ۬لْحَآقَّةُۖ", "number_in_hafs": [1, 2]}, {"chapter": 69, "verse": 2, "text": "وَمَآ أَدْر۪يٰكَ مَا اَ۬لْحَآقَّةُۖ", "number_in_hafs": [3]}, {"chapter": 69, "verse": 3, "text": "كَذَّبَتْ ثَمُودُ وَعَادُۢ بِالْقَارِعَةِۖ", "number_in_hafs": [4]}, {"chapter": 69, "verse": 4, "text": "فَأَمَّا ثَمُودُ فَأُهْلِكُواْ بِالطَّاغِيَةِۖ", "number_in_hafs": [5]}, {"chapter": 69, "verse": 5, "text": "وَأَمَّا عَادٞ فَأُهْلِكُواْ بِرِيحٖ صَرْصَرٍ عَاتِيَةٖ", "number_in_hafs": [6]}, {"chapter": 69, "verse": 6, "text": "سَخَّرَهَا عَلَيْهِمْ سَبْعَ لَيَالٖ وَثَمَٰنِيَةَ أَيَّامٍ حُسُوماٗۖ فَتَرَى اَ۬لْقَوْمَ فِيهَا صَرْع۪ىٰ كَأَنَّهُمُۥٓ أَعْجَازُ نَخْلٍ خَاوِيَةٖۖ", "number_in_hafs": [7]}, {"chapter": 69, "verse": 7, "text": "فَهَلْ تَر۪ىٰ لَهُم مِّنۢ بَاقِيَةٖۖ", "number_in_hafs": [8]}, {"chapter": 69, "verse": 8, "text": "وَجَآءَ فِرْعَوْنُ وَمَن قَبْلَهُۥ وَالْمُوتَفِكَٰتُ بِالْخَاطِيـَٔةِ", "number_in_hafs": [9]}, {"chapter": 69, "verse": 9, "text": "فَعَصَوْاْ رَسُولَ رَبِّهِمْ فَأَخَذَهُمُۥٓ أَخْذَةٗ رَّابِيَةًۖ", "number_in_hafs": [10]}, {"chapter": 69, "verse": 10, "text": "اِنَّا لَمَّا طَغَا اَ۬لْمَآءُ حَمَلْنَٰكُمْ فِے اِ۬لْجَارِيَةِ", "number_in_hafs": [11]}, {"chapter": 69, "verse": 11, "text": "لِنَجْعَلَهَا لَكُمْ تَذْكِرَةٗ وَتَعِيَهَآ أُذْنٞ وَٰعِيَةٞۖ", "number_in_hafs": [12]}, {"chapter": 69, "verse": 12, "text": "فَإِذَا نُفِخَ فِے اِ۬لصُّورِ نَفْخَةٞ وَٰحِدَةٞ", "number_in_hafs": [13]}, {"chapter": 69, "verse": 13, "text": "وَحُمِلَتِ اِ۬لَارْضُ وَالْجِبَالُ فَدُكَّتَا دَكَّةٗ وَٰحِدَةٗ", "number_in_hafs": [14]}, {"chapter": 69, "verse": 14, "text": "فَيَوْمَئِذٖ وَقَعَتِ اِ۬لْوَاقِعَةُ", "number_in_hafs": [15]}, {"chapter": 69, "verse": 15, "text": "وَانشَقَّتِ اِ۬لسَّمَآءُ فَهِيَ يَوْمَئِذٖ وَاهِيَةٞ", "number_in_hafs": [16]}, {"chapter": 69, "verse": 16, "text": "وَالْمَلَكُ عَلَىٰٓ أَرْجَآئِهَاۖ وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِذٖ ثَمَٰنِيَةٞ", "number_in_hafs": [17]}, {"chapter": 69, "verse": 17, "text": "يَوْمَئِذٖ تُعْرَضُونَ لَا تَخْف۪ىٰ مِنكُمْ خَافِيَةٞۖ", "number_in_hafs": [18]}, {"chapter": 69, "verse": 18, "text": "۞ فَأَمَّا مَنُ ا۟وتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ فَيَقُولُ هَآؤُمُ اُ۪قْرَءُواْ كِتَٰبِيَهْۖ", "number_in_hafs": [19]}, {"chapter": 69, "verse": 19, "text": "إِنِّے ظَنَنتُ أَنِّے مُلَٰقٍ حِسَابِيَهْۖ", "number_in_hafs": [20]}, {"chapter": 69, "verse": 20, "text": "فَهُوَ فِے عِيشَةٖ رَّاضِيَةٖ", "number_in_hafs": [21]}, {"chapter": 69, "verse": 21, "text": "فِے جَنَّةٍ عَالِيَةٖ", "number_in_hafs": [22]}, {"chapter": 69, "verse": 22, "text": "قُطُوفُهَا دَانِيَةٞۖ", "number_in_hafs": [23]}, {"chapter": 69, "verse": 23, "text": "كُلُواْ وَاشْرَبُواْۖ هَنِيٓــٔاَۢ بِمَآ أَسْلَفْتُمْ فِے اِ۬لَايَّامِ اِ۬لْخَالِيَةِۖ", "number_in_hafs": [24]}, {"chapter": 69, "verse": 24, "text": "وَأَمَّا مَنُ ا۟وتِيَ كِتَٰبَهُۥ بِشِمَالِهِۦ", "number_in_hafs": [25]}, {"chapter": 69, "verse": 25, "text": "فَيَقُولُ يَٰلَيْتَنِے لَمُ ا۟وتَ كِتَٰبِيَهْۖ", "number_in_hafs": [25]}, {"chapter": 69, "verse": 26, "text": "وَلَمَ اَدْرِ مَا حِسَابِيَهْۖ", "number_in_hafs": [26]}, {"chapter": 69, "verse": 27, "text": "يَٰلَيْتَهَا كَانَتِ اِ۬لْقَاضِيَةَ", "number_in_hafs": [27]}, {"chapter": 69, "verse": 28, "text": "مَآ أَغْن۪ىٰ عَنِّے مَالِيَهۖ", "number_in_hafs": [28]}, {"chapter": 69, "verse": 29, "text": "هَّلَكَ عَنِّے سُلْطَٰنِيَهْۖ", "number_in_hafs": [29]}, {"chapter": 69, "verse": 30, "text": "خُذُوهُ فَغُلُّوهُ", "number_in_hafs": [30]}, {"chapter": 69, "verse": 31, "text": "ثُمَّ اَ۬لْجَحِيمَ صَلُّوهُ", "number_in_hafs": [31]}, {"chapter": 69, "verse": 32, "text": "ثُمَّ فِے سِلْسِلَةٖ ذَرْعُهَا سَبْعُونَ ذِرَاعاٗ فَاسْلُكُوهُۖ", "number_in_hafs": [32]}, {"chapter": 69, "verse": 33, "text": "إِنَّهُۥ كَانَ لَا يُومِنُ بِاللَّهِ اِ۬لْعَظِيمِ", "number_in_hafs": [33]}, {"chapter": 69, "verse": 34, "text": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ اِ۬لْمِسْكِينِۖ", "number_in_hafs": [34]}, {"chapter": 69, "verse": 35, "text": "فَلَيْسَ لَهُ اُ۬لْيَوْمَ هَٰهُنَا حَمِيمٞ", "number_in_hafs": [35]}, {"chapter": 69, "verse": 36, "text": "وَلَا طَعَامٌ اِلَّا مِنْ غِسْلِينٖ", "number_in_hafs": [36]}, {"chapter": 69, "verse": 37, "text": "لَّا يَاكُلُهُۥٓ إِلَّا اَ۬لْخَٰطِــُٔونَۖ", "number_in_hafs": [37]}, {"chapter": 69, "verse": 38, "text": "فَلَآ أُقْسِمُ بِمَا تُبْصِرُونَ", "number_in_hafs": [38]}, {"chapter": 69, "verse": 39, "text": "وَمَا لَا تُبْصِرُونَ", "number_in_hafs": [39]}, {"chapter": 69, "verse": 40, "text": "إِنَّهُۥ لَقَوْلُ رَسُولٖ كَرِيمٖ", "number_in_hafs": [40]}, {"chapter": 69, "verse": 41, "text": "وَمَا هُوَ بِقَوْلِ شَاعِرٖ قَلِيلاٗ مَّا تُومِنُونَ", "number_in_hafs": [41]}, {"chapter": 69, "verse": 42, "text": "وَلَا بِقَوْلِ كَاهِنٖۖ قَلِيلاٗ مَّا تَذَّكَّرُونَۖ", "number_in_hafs": [42]}, {"chapter": 69, "verse": 43, "text": "تَنزِيلٞ مِّن رَّبِّ اِ۬لْعَٰلَمِينَۖ", "number_in_hafs": [43]}, {"chapter": 69, "verse": 44, "text": "وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ اَ۬لَاقَاوِيلِ", "number_in_hafs": [44]}, {"chapter": 69, "verse": 45, "text": "لَأَخَذْنَا مِنْهُ بِالْيَمِينِ", "number_in_hafs": [45]}, {"chapter": 69, "verse": 46, "text": "ثُمَّ لَقَطَعْنَا مِنْهُ اُ۬لْوَتِينَ", "number_in_hafs": [46]}, {"chapter": 69, "verse": 47, "text": "فَمَا مِنكُم مِّنَ اَحَدٍ عَنْهُ حَٰجِزِينَۖ", "number_in_hafs": [47]}, {"chapter": 69, "verse": 48, "text": "وَإِنَّهُۥ لَتَذْكِرَةٞ لِّلْمُتَّقِينَۖ", "number_in_hafs": [48]}, {"chapter": 69, "verse": 49, "text": "وَإِنَّا لَنَعْلَمُ أَنَّ مِنكُم مُّكَذِّبِينَۖ", "number_in_hafs": [49]}, {"chapter": 69, "verse": 50, "text": "وَإِنَّهُۥ لَحَسْرَةٌ عَلَى اَ۬لْكٰ۪فِرِينَۖ", "number_in_hafs": [50]}, {"chapter": 69, "verse": 51, "text": "وَإِنَّهُۥ لَحَقُّ اُ۬لْيَقِينِۖ", "number_in_hafs": [51]}, {"chapter": 69, "verse": 52, "text": "فَسَبِّحْ بِاسْمِ رَبِّكَ اَ۬لْعَظِيمِۖ", "number_in_hafs": [52]}]}