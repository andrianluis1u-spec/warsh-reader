{"chapter": 86, "verses": [{"chapter": 86, "verse": 1, "text": "وَالسَّمَآءِ وَالطَّارِقِ", "number_in_hafs": [1]}, {"chapter": 86, "verse": 2, "text": "وَمَآ أَدْر۪يٰكَ مَا اَ۬لطَّارِقُ", "number_in_hafs": [2]}, {"chapter": 86, "verse": 3, "text": "اُ۬لنَّجْمُ اُ۬لثَّاقِبُ", "number_in_hafs": [3]}, {"chapter": 86, "verse": 4, "text": "إِن كُلُّ نَفْسٖ لَّمَا عَلَيْهَا حَافِظٞۖ", "number_in_hafs": [4]}, {"chapter": 86, "verse": 5, "text": "فَلْيَنظُرِ اِ۬لِانسَٰنُ مِمَّ خُلِقَۖ", "number_in_hafs": [5]}, {"chapter": 86, "verse": 6, "text": "خُلِقَ مِن مَّآءٖ دَافِقٖ", "number_in_hafs": [6]}, {"chapter": 86, "verse": 7, "text": "يَخْرُجُ مِنۢ بَيْنِ اِ۬لصُّلْبِ وَالتَّرَآئِبِۖ", "number_in_hafs": [7]}, {"chapter": 86, "verse": 8, "text": "إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٞ", "number_in_hafs": [8]}, {"chapter": 86, "verse": 9, "text": "يَوْمَ تُبْلَى اَ۬لسَّرَآئِرُ", "number_in_hafs": [9]}, {"chapter": 86, "verse": 10, "text": "فَمَا لَهُۥ مِن قُوَّةٖ وَلَا نَاصِرٖۖ", "number_in_hafs": [10]}, {"chapter": 86, "verse": 11, "text": "وَالسَّمَآءِ ذَاتِ اِ۬لرَّجْعِ", "number_in_hafs": [11]}, {"chapter": 86, "verse": 12, "text": "وَالَارْضِ ذَاتِ اِ۬لصَّدْعِ", "number_in_hafs": [12]}, {"chapter": 86, "verse": 13, "text": "إِنَّهُۥ لَقَوْلٞ فَصْلٞ", "number_in_hafs": [13]}, {"chapter": 86, "verse": 14, "text": "وَمَا هُوَ بِالْهَزْلِۖ", "number_in_hafs": [14]}, {"chapter": 86, "verse": 15, "text": "إِنَّهُمْ يَكِيدُونَ كَيْداٗ", "number_in_hafs": [15]}, {"chapter": 86, "verse": 16, "text": "وَأَكِيدُ كَيْداٗۖ", "number_in_hafs": [16]}, {"chapter": 86, "verse": 17, "text": "فَمَهِّلِ اِ۬لْكٰ۪فِرِينَ أَمْهِلْهُمْ رُوَيْداٗۖ", "number_in_hafs": [17]}]}