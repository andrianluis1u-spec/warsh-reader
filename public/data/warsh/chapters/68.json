{"chapter": 68, "verses": [{"chapter": 68, "verse": 1, "text": "نُّٓۖ وَالْقَلَمِ وَمَا يَسْطُرُونَ", "number_in_hafs": [1]}, {"chapter": 68, "verse": 2, "text": "مَآ أَنتَ بِنِعْمَةِ رَبِّكَ بِمَجْنُونٖ", "number_in_hafs": [2]}, {"chapter": 68, "verse": 3, "text": "وَإِنَّ لَكَ لَأَجْراً غَيْرَ مَمْنُونٖ", "number_in_hafs": [3]}, {"chapter": 68, "verse": 4, "text": "وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٖۖ", "number_in_hafs": [4]}, {"chapter": 68, "verse": 5, "text": "فَسَتُبْصِرُ وَيُبْصِرُونَ", "number_in_hafs": [5]}, {"chapter": 68, "verse": 6, "text": "بِأَييِّكُمُ اُ۬لْمَفْتُونُۖ", "number_in_hafs": [6]}, {"chapter": 68, "verse": 7, "text": "إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦۖ وَهُوَ أَعْلَمُ بِالْمُهْتَدِينَۖ", "number_in_hafs": [7]}, {"chapter": 68, "verse": 8, "text": "فَلَا تُطِعِ اِ۬لْمُكَذِّبِينَۖ", "number_in_hafs": [8]}, {"chapter": 68, "verse": 9, "text": "وَدُّواْ لَوْ تُدْهِنُ فَيُدْهِنُونَۖ", "number_in_hafs": [9]}, {"chapter": 68, "verse": 10, "text": "وَلَا تُطِعْ كُلَّ حَلَّٰفٖ مَّهِينٍ", "number_in_hafs": [10]}, {"chapter": 68, "verse": 11, "text": "هَمَّازٖ مَّشَّآءِۢ بِنَمِيمٖ", "number_in_hafs": [11]}, {"chapter": 68, "verse": 12, "text": "مَّنَّاعٖ لِّلْخَيْرِ مُعْتَدٍ اَثِيمٍ", "number_in_hafs": [12]}, {"chapter": 68, "verse": 13, "text": "عُتُلِّۢ بَعْدَ ذَٰلِكَ زَنِيمٍ", "number_in_hafs": [13]}, {"chapter": 68, "verse": 14, "text": "اَن كَانَ ذَا مَالٖ وَبَنِينَ", "number_in_hafs": [14]}, {"chapter": 68, "verse": 15, "text": "إِذَا تُتْل۪ىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ اُ۬لَاوَّلِينَۖ", "number_in_hafs": [15]}, {"chapter": 68, "verse": 16, "text": "سَنَسِمُهُۥ عَلَى اَ۬لْخُرْطُومِۖ", "number_in_hafs": [16]}, {"chapter": 68, "verse": 17, "text": "إِنَّا بَلَوْنَٰهُمْ كَمَا بَلَوْنَآ أَصْحَٰبَ اَ۬لْجَنَّةِ إِذَ اَقْسَمُواْ لَيَصْرِمُنَّهَا مُصْبِحِينَ", "number_in_hafs": [17]}, {"chapter": 68, "verse": 18, "text": "وَلَا يَسْتَثْنُونَۖ", "number_in_hafs": [18]}, {"chapter": 68, "verse": 19, "text": "۞ فَطَافَ عَلَيْهَا طَآئِفٞ مِّن رَّبِّكَ وَهُمْ نَآئِمُونَ", "number_in_hafs": [19]}, {"chapter": 68, "verse": 20, "text": "فَأَصْبَحَتْ كَالصَّرِيمِۖ", "number_in_hafs": [20]}, {"chapter": 68, "verse": 21, "text": "فَتَنَادَوْاْ مُصْبِحِينَ", "number_in_hafs": [21]}, {"chapter": 68, "verse": 22, "text": "أَنُ اُ۟غْدُواْ عَلَىٰ حَرْثِكُمُۥٓ إِن كُنتُمْ صَٰرِمِينَۖ", "number_in_hafs": [22]}, {"chapter": 68, "verse": 23, "text": "فَانطَلَقُواْ وَهُمْ يَتَخَٰفَتُونَ", "number_in_hafs": [23]}, {"chapter": 68, "verse": 24, "text": "أَن لَّا يَدْخُلَنَّهَا اَ۬لْيَوْمَ عَلَيْكُم مِّسْكِينٞۖ", "number_in_hafs": [24]}, {"chapter": 68, "verse": 25, "text": "وَغَدَوْاْ عَلَىٰ حَرْدٖ قَٰدِرِينَۖ", "number_in_hafs": [25]}, {"chapter": 68, "verse": 26, "text": "فَلَمَّا رَأَوْهَا قَالُوٓاْ إِنَّا لَضَآلُّونَ", "number_in_hafs": [26]}, {"chapter": 68, "verse": 27, "text": "بَلْ نَحْنُ مَحْرُومُونَۖ", "number_in_hafs": [27]}, {"chapter": 68, "verse": 28, "text": "قَالَ أَوْسَطُهُمُۥٓ أَلَمَ اَقُل لَّكُمْ لَوْلَا تُسَبِّحُونَۖ", "number_in_hafs": [28]}, {"chapter": 68, "verse": 29, "text": "قَالُواْ سُبْحَٰنَ رَبِّنَآ إِنَّا كُنَّا ظَٰلِمِينَۖ", "number_in_hafs": [29]}, {"chapter": 68, "verse": 30, "text": "فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٖ يَتَلَٰوَمُونَۖ", "number_in_hafs": [30]}, {"chapter": 68, "verse": 31, "text": "قَالُواْ يَٰوَيْلَنَآ إِنَّا كُنَّا طَٰغِينَ", "number_in_hafs": [31]}, {"chapter": 68, "verse": 32, "text": "عَس۪ىٰ رَبُّنَآ أَنْ يُّبَدِّلَنَا خَيْراٗ مِّنْهَآ إِنَّآ إِلَىٰ رَبِّنَا رَٰغِبُونَۖ", "number_in_hafs": [32]}, {"chapter": 68, "verse": 33, "text": "كَذَٰلِكَ اَ۬لْعَذَابُۖ وَلَعَذَابُ اُ۬لَاخِرَةِ أَكْبَرُ لَوْ كَانُواْ يَعْلَمُونَۖ", "number_in_hafs": [33]}, {"chapter": 68, "verse": 34, "text": "إِنَّ لِلْمُتَّقِينَ عِندَ رَبِّهِمْ جَنَّٰتِ اِ۬لنَّعِيمِۖ", "number_in_hafs": [34]}, {"chapter": 68, "verse": 35, "text": "أَفَنَجْعَلُ اُ۬لْمُسْلِمِينَ كَالْمُجْرِمِينَۖ", "number_in_hafs": [35]}, {"chapter": 68, "verse": 36, "text": "مَا لَكُمْۖ كَيْفَ تَحْكُمُونَۖ", "number_in_hafs": [36]}, {"chapter": 68, "verse": 37, "text": "أَمْ لَكُمْ كِتَٰبٞ فِيهِ تَدْرُسُونَ", "number_in_hafs": [37]}, {"chapter": 68, "verse": 38, "text": "إِنَّ لَكُمْ فِيهِ لَمَا تَخَيَّرُونَۖ", "number_in_hafs": [38]}, {"chapter": 68, "verse": 39, "text": "أَمْ لَكُمُۥٓ أَيْمَٰنٌ عَلَيْنَا بَٰلِغَةٌ اِلَىٰ يَوْمِ اِ۬لْقِيَٰمَةِ إِنَّ لَكُمْ لَمَا تَحْكُمُونَۖ", "number_in_hafs": [39]}, {"chapter": 68, "verse": 40, "text": "سَلْهُمُۥٓ أَيُّهُم بِذَٰلِكَ زَعِيمٌۖ", "number_in_hafs": [40]}, {"chapter": 68, "verse": 41, "text": "اَمْ لَهُمْ شُرَكَآءُ فَلْيَاتُواْ بِشُرَكَآئِهِمُۥٓ إِن كَانُواْ صَٰدِقِينَۖ", "number_in_hafs": [41]}, {"chapter": 68, "verse": 42, "text": "يَوْمَ يُكْشَفُ عَن سَاقٖ وَيُدْعَوْنَ إِلَى اَ۬لسُّجُودِ فَلَا يَسْتَطِيعُونَۖ", "number_in_hafs": [42]}, {"chapter": 68, "verse": 43, "text": "خَٰشِعَةً اَبْصَٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٞۖ وَقَدْ كَانُواْ يُدْعَوْنَ إِلَى اَ۬لسُّجُودِ وَهُمْ سَٰلِمُونَۖ", "number_in_hafs": [43]}, {"chapter": 68, "verse": 44, "text": "فَذَرْنِے وَمَنْ يُّكَذِّبُ بِهَٰذَا اَ۬لْحَدِيثِۖ سَنَسْتَدْرِجُهُم مِّنْ حَيْثُ لَا يَعْلَمُونَ", "number_in_hafs": [44]}, {"chapter": 68, "verse": 45, "text": "وَأُمْلِے لَهُمُۥٓۖ إِنَّ كَيْدِے مَتِينٌۖ", "number_in_hafs": [45]}, {"chapter": 68, "verse": 46, "text": "اَمْ تَسْــَٔلُهُمُۥٓ أَجْراٗ فَهُم مِّن مَّغْرَمٖ مُّثْقَلُونَۖ", "number_in_hafs": [46]}, {"chapter": 68, "verse": 47, "text": "أَمْ عِندَهُمُ اُ۬لْغَيْبُ فَهُمْ يَكْتُبُونَۖ", "number_in_hafs": [47]}, {"chapter": 68, "verse": 48, "text": "۞ فَاصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تَكُن كَصَٰحِبِ اِ۬لْحُوتِ إِذْ نَاد۪ىٰ وَهُوَ مَكْظُومٞۖ", "number_in_hafs": [48]}, {"chapter": 68, "verse": 49, "text": "لَّوْلَآ أَن تَدَٰرَكَهُۥ نِعْمَةٞ مِّن رَّبِّهِۦ لَنُبِذَ بِالْعَرَآءِ وَهُوَ مَذْمُومٞۖ", "number_in_hafs": [49]}, {"chapter": 68, "verse": 50, "text": "فَاجْتَبٰ۪هُ رَبُّهُۥ فَجَعَلَهُۥ مِنَ اَ۬لصَّٰلِحِينَۖ", "number_in_hafs": [50]}, {"chapter": 68, "verse": 51, "text": "وَإِنْ يَّكَادُ اُ۬لذِينَ كَفَرُواْ لَيَزْلِقُونَكَ بِأَبْصٰ۪رِهِمْ لَمَّا سَمِعُواْ اُ۬لذِّكْرَ وَيَقُولُونَ إِنَّهُۥ لَمَجْنُونٞۖ", "number_in_hafs": [51]}, {"chapter": 68, "verse": 52, "text": "وَمَا هُوَ إِلَّا ذِكْرٞ لِّلْعَٰلَمِينَۖ", "number_in_hafs": [52]}]}