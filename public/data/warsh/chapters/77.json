{"chapter": 77, "verses": [{"chapter": 77, "verse": 1, "text": "وَالْمُرْسَلَٰتِ عُرْفاٗ", "number_in_hafs": [1]}, {"chapter": 77, "verse": 2, "text": "فَالْعَٰصِفَٰتِ عَصْفاٗ", "number_in_hafs": [2]}, {"chapter": 77, "verse": 3, "text": "وَالنَّٰشِرَٰتِ نَشْراٗ", "number_in_hafs": [3]}, {"chapter": 77, "verse": 4, "text": "فَالْفَٰرِقَٰتِ فَرْقاٗ", "number_in_hafs": [4]}, {"chapter": 77, "verse": 5, "text": "فَالْمُلْقِيَٰتِ ذِكْراً", "number_in_hafs": [5]}, {"chapter": 77, "verse": 6, "text": "عُذْراً اَوْ نُذُراً", "number_in_hafs": [6]}, {"chapter": 77, "verse": 7, "text": "اِنَّمَا تُوعَدُونَ لَوَٰقِعٞۖ", "number_in_hafs": [7]}, {"chapter": 77, "verse": 8, "text": "فَإِذَا اَ۬لنُّجُومُ طُمِسَتْ", "number_in_hafs": [8]}, {"chapter": 77, "verse": 9, "text": "وَإِذَا اَ۬لسَّمَآءُ فُرِجَتْ", "number_in_hafs": [9]}, {"chapter": 77, "verse": 10, "text": "وَإِذَا اَ۬لْجِبَالُ نُسِفَتْ", "number_in_hafs": [10]}, {"chapter": 77, "verse": 11, "text": "وَإِذَا اَ۬لرُّسُلُ أُقِّتَتْ", "number_in_hafs": [11]}, {"chapter": 77, "verse": 12, "text": "لِأَيِّ يَوْمٍ ا۟جِّلَتْ", "number_in_hafs": [12]}, {"chapter": 77, "verse": 13, "text": "لِيَوْمِ اِ۬لْفَصْلِۖ", "number_in_hafs": [13]}, {"chapter": 77, "verse": 14, "text": "وَمَآ أَدْر۪يٰكَ مَا يَوْمُ اُ۬لْفَصْلِۖ", "number_in_hafs": [14]}, {"chapter": 77, "verse": 15, "text": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ", "number_in_hafs": [15]}, {"chapter": 77, "verse": 16, "text": "۞ أَلَمْ نُهْلِكِ اِ۬لَاوَّلِينَۖ", "number_in_hafs": [16]}, {"chapter": 77, "verse": 17, "text": "ثُمَّ نُتْبِعُهُمُ اُ۬لَاخِرِينَۖ", "number_in_hafs": [17]}, {"chapter": 77, "verse": 18, "text": "كَذَٰلِكَ نَفْعَلُ بِالْمُجْرِمِينَۖ", "number_in_hafs": [18]}, {"chapter": 77, "verse": 19, "text": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ", "number_in_hafs": [19]}, {"chapter": 77, "verse": 20, "text": "أَلَمْ نَخْلُقكُّم مِّن مَّآءٖ مَّهِينٖ", "number_in_hafs": [20]}, {"chapter": 77, "verse": 21, "text": "فَجَعَلْنَٰهُ فِے قَر۪ارٖ مَّكِينٍ", "number_in_hafs": [21]}, {"chapter": 77, "verse": 22, "text": "اِلَىٰ قَدَرٖ مَّعْلُومٖ", "number_in_hafs": [22]}, {"chapter": 77, "verse": 23, "text": "فَقَدَّرْنَاۖ فَنِعْمَ اَ۬لْقَٰدِرُونَۖ", "number_in_hafs": [23]}, {"chapter": 77, "verse": 24, "text": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ", "number_in_hafs": [24]}, {"chapter": 77, "verse": 25, "text": "أَلَمْ نَجْعَلِ اِ۬لَارْضَ كِفَاتاً", "number_in_hafs": [25]}, {"chapter": 77, "verse": 26, "text": "اَحْيَآءٗ وَأَمْوَٰتاٗ", "number_in_hafs": [26]}, {"chapter": 77, "verse": 27, "text": "وَجَعَلْنَا فِيهَا رَوَٰسِيَ شَٰمِخَٰتٖ وَأَسْقَيْنَٰكُم مَّآءٗ فُرَاتاٗۖ", "number_in_hafs": [27]}, {"chapter": 77, "verse": 28, "text": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ", "number_in_hafs": [28]}, {"chapter": 77, "verse": 29, "text": "اَ۪نطَلِقُوٓاْ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ", "number_in_hafs": [29]}, {"chapter": 77, "verse": 30, "text": "اَ۪نطَلِقُوٓاْ إِلَىٰ ظِلّٖ ذِے ثَلَٰثِ شُعَبٖ", "number_in_hafs": [30]}, {"chapter": 77, "verse": 31, "text": "لَّا ظَلِيلٖ وَلَا يُغْنِے مِنَ اَ۬للَّهَبِۖ", "number_in_hafs": [31]}, {"chapter": 77, "verse": 32, "text": "إِنَّهَا تَرْمِے بِشَرَرٖ كَالْقَصْرِ", "number_in_hafs": [32]}, {"chapter": 77, "verse": 33, "text": "كَأَنَّهُۥ جِمَٰلَٰتٞ صُفْرٞۖ", "number_in_hafs": [33]}, {"chapter": 77, "verse": 34, "text": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ", "number_in_hafs": [34]}, {"chapter": 77, "verse": 35, "text": "هَٰذَا يَوْمُ لَا يَنطِقُونَ", "number_in_hafs": [35]}, {"chapter": 77, "verse": 36, "text": "وَلَا يُوذَنُ لَهُمْ فَيَعْتَذِرُونَۖ", "number_in_hafs": [36]}, {"chapter": 77, "verse": 37, "text": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ", "number_in_hafs": [37]}, {"chapter": 77, "verse": 38, "text": "هَٰذَا يَوْمُ اُ۬لْفَصْلِ جَمَعْنَٰكُمْ وَالَاوَّلِينَ", "number_in_hafs": [38]}, {"chapter": 77, "verse": 39, "text": "فَإِن كَانَ لَكُمْ كَيْدٞ فَكِيدُونِۖ", "number_in_hafs": [39]}, {"chapter": 77, "verse": 40, "text": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ", "number_in_hafs": [40]}, {"chapter": 77, "verse": 41, "text": "إِنَّ اَ۬لْمُتَّقِينَ فِے ظِلَٰلٖ وَعُيُونٖ", "number_in_hafs": [41]}, {"chapter": 77, "verse": 42, "text": "وَفَوَٰكِهَ مِمَّا يَشْتَهُونَۖ", "number_in_hafs": [42]}, {"chapter": 77, "verse": 43, "text": "كُلُواْ وَاشْرَبُواْۖ هَنِيٓــٔاَۢ بِمَا كُنتُمْ تَعْمَلُونَۖ", "number_in_hafs": [43]}, {"chapter": 77, "verse": 44, "text": "إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ", "number_in_hafs": [44]}, {"chapter": 77, "verse": 45, "text": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ", "number_in_hafs": [45]}, {"chapter": 77, "verse": 46, "text": "كُلُواْ وَتَمَتَّعُواْ قَلِيلاً اِنَّكُم مُّجْرِمُونَۖ", "number_in_hafs": [46]}, {"chapter": 77, "verse": 47, "text": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ", "number_in_hafs": [47]}, {"chapter": 77, "verse": 48, "text": "وَإِذَا قِيلَ لَهُمُ اُ۪رْكَعُواْ لَا يَرْكَعُونَۖ", "number_in_hafs": [48]}, {"chapter": 77, "verse": 49, "text": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ", "number_in_hafs": [49]}, {"chapter": 77, "verse": 50, "text": "فَبِأَيِّ حَدِيثِۢ بَعْدَهُۥ يُومِنُونَۖ", "number_in_hafs": [50]}]}