{"chapter": 56, "verses": [{"chapter": 56, "verse": 1, "text": "إِذَا وَقَعَتِ اِ۬لْوَاقِعَةُ", "number_in_hafs": [1]}, {"chapter": 56, "verse": 2, "text": "لَيْسَ لِوَقْعَتِهَا كَٰذِبَةٌۖ", "number_in_hafs": [2]}, {"chapter": 56, "verse": 3, "text": "خَافِضَةٞ رَّافِعَةٌ", "number_in_hafs": [3]}, {"chapter": 56, "verse": 4, "text": "اِذَا رُجَّتِ اِ۬لَارْضُ رَجّاٗ", "number_in_hafs": [4]}, {"chapter": 56, "verse": 5, "text": "وَبُسَّتِ اِ۬لْجِبَالُ بَسّاٗ", "number_in_hafs": [5]}, {"chapter": 56, "verse": 6, "text": "فَكَانَتْ هَبَآءٗ مُّنۢبَثّاٗ", "number_in_hafs": [6]}, {"chapter": 56, "verse": 7, "text": "وَكُنتُمُۥٓ أَزْوَٰجاٗ ثَلَٰثَةٗۖ", "number_in_hafs": [7]}, {"chapter": 56, "verse": 8, "text": "فَأَصْحَٰبُ اُ۬لْمَيْمَنَةِ", "number_in_hafs": [8]}, {"chapter": 56, "verse": 9, "text": "مَآ أَصْحَٰبُ اُ۬لْمَيْمَنَةِۖ", "number_in_hafs": [8]}, {"chapter": 56, "verse": 10, "text": "وَأَصْحَٰبُ اُ۬لْمَشْــَٔمَةِ", "number_in_hafs": [9]}, {"chapter": 56, "verse": 11, "text": "مَآ أَصْحَٰبُ اُ۬لْمَشْــَٔمَةِۖ", "number_in_hafs": [9]}, {"chapter": 56, "verse": 12, "text": "وَالسَّٰبِقُونَ اَ۬لسَّٰبِقُونَۖ", "number_in_hafs": [10]}, {"chapter": 56, "verse": 13, "text": "أُوْلَٰٓئِكَ اَ۬لْمُقَرَّبُونَ", "number_in_hafs": [11]}, {"chapter": 56, "verse": 14, "text": "فِے جَنَّٰتِ اِ۬لنَّعِيمِۖ", "number_in_hafs": [12]}, {"chapter": 56, "verse": 15, "text": "ثُلَّةٞ مِّنَ اَ۬لَاوَّلِينَ", "number_in_hafs": [13]}, {"chapter": 56, "verse": 16, "text": "وَقَلِيلٞ مِّنَ اَ۬لَاخِرِينَ", "number_in_hafs": [14]}, {"chapter": 56, "verse": 17, "text": "عَلَىٰ سُرُرٖ مَّوْضُونَةٖ", "number_in_hafs": [15]}, {"chapter": 56, "verse": 18, "text": "مُّتَّكِـِٕينَ عَلَيْهَا مُتَقَٰبِلِينَۖ", "number_in_hafs": [16]}, {"chapter": 56, "verse": 19, "text": "يَطُوفُ عَلَيْهِمْ وِلْدَٰنٞ مُّخَلَّدُونَ", "number_in_hafs": [17]}, {"chapter": 56, "verse": 20, "text": "بِأَكْوَابٖ وَأَبَارِيقَ", "number_in_hafs": [18]}, {"chapter": 56, "verse": 21, "text": "وَكَأْسٖ مِّن مَّعِينٖ", "number_in_hafs": [18]}, {"chapter": 56, "verse": 22, "text": "لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزَفُونَ", "number_in_hafs": [19]}, {"chapter": 56, "verse": 23, "text": "وَفَٰكِهَةٖ مِّمَّا يَتَخَيَّرُونَ", "number_in_hafs": [20]}, {"chapter": 56, "verse": 24, "text": "وَلَحْمِ طَيْرٖ مِّمَّا يَشْتَهُونَۖ", "number_in_hafs": [21]}, {"chapter": 56, "verse": 25, "text": "وَحُورٌ عِينٞ كَأَمْثَٰلِ اِ۬للُّؤْلُوِٕ اِ۬لْمَكْنُونِ", "number_in_hafs": [22, 23]}, {"chapter": 56, "verse": 26, "text": "جَزَآءَۢ بِمَا كَانُواْ يَعْمَلُونَۖ", "number_in_hafs": [24]}, {"chapter": 56, "verse": 27, "text": "لَا يَسْمَعُونَ فِيهَا لَغْواٗ وَلَا تَاثِيماًۖ", "number_in_hafs": [25]}, {"chapter": 56, "verse": 28, "text": "اِلَّا قِيلاٗ سَلَٰماٗ سَلَٰماٗۖ", "number_in_hafs": [26]}, {"chapter": 56, "verse": 29, "text": "وَأَصْحَٰبُ اُ۬لْيَمِينِ مَآ أَصْحَٰبُ اُ۬لْيَمِينِۖ", "number_in_hafs": [27]}, {"chapter": 56, "verse": 30, "text": "فِے سِدْرٖ مَّخْضُودٖ", "number_in_hafs": [28]}, {"chapter": 56, "verse": 31, "text": "وَطَلْحٖ مَّنضُودٖ", "number_in_hafs": [29]}, {"chapter": 56, "verse": 32, "text": "وَظِلّٖ مَّمْدُودٖ", "number_in_hafs": [30]}, {"chapter": 56, "verse": 33, "text": "وَمَآءٖ مَّسْكُوبٖ", "number_in_hafs": [31]}, {"chapter": 56, "verse": 34, "text": "وَفَٰكِهَةٖ كَثِيرَةٖ", "number_in_hafs": [32]}, {"chapter": 56, "verse": 35, "text": "لَّا مَقْطُوعَةٖ وَلَا مَمْنُوعَةٖ", "number_in_hafs": [33]}, {"chapter": 56, "verse": 36, "text": "وَفُرُشٖ مَّرْفُوعَةٍۖ", "number_in_hafs": [34]}, {"chapter": 56, "verse": 37, "text": "اِنَّآ أَنشَأْنَٰهُنَّ إِنشَآءٗ", "number_in_hafs": [35]}, {"chapter": 56, "verse": 38, "text": "فَجَعَلْنَٰهُنَّ أَبْكَاراً", "number_in_hafs": [36]}, {"chapter": 56, "verse": 39, "text": "عُرُباً اَتْرَاباٗ", "number_in_hafs": [37]}, {"chapter": 56, "verse": 40, "text": "لِّأَصْحَٰبِ اِ۬لْيَمِينِۖ", "number_in_hafs": [38]}, {"chapter": 56, "verse": 41, "text": "ثُلَّةٞ مِّنَ اَ۬لَاوَّلِينَ", "number_in_hafs": [39]}, {"chapter": 56, "verse": 42, "text": "وَثُلَّةٞ مِّنَ اَ۬لَاخِرِينَۖ", "number_in_hafs": [40]}, {"chapter": 56, "verse": 43, "text": "وَأَصْحَٰبُ اُ۬لشِّمَالِ", "number_in_hafs": [41]}, {"chapter": 56, "verse": 44, "text": "مَآ أَصْحَٰبُ اُ۬لشِّمَالِۖ", "number_in_hafs": [41]}, {"chapter": 56, "verse": 45, "text": "فِے سَمُومٖ وَحَمِيمٖ", "number_in_hafs": [42]}, {"chapter": 56, "verse": 46, "text": "وَظِلّٖ مِّنْ يَّحْمُومٖ", "number_in_hafs": [43]}, {"chapter": 56, "verse": 47, "text": "لَّا بَارِدٖ وَلَا كَرِيمٍۖ", "number_in_hafs": [44]}, {"chapter": 56, "verse": 48, "text": "اِنَّهُمْ كَانُواْ قَبْلَ ذَٰلِكَ مُتْرَفِينَۖ", "number_in_hafs": [45]}, {"chapter": 56, "verse": 49, "text": "وَكَانُواْ يُصِرُّونَ عَلَى اَ۬لْحِنثِ اِ۬لْعَظِيمِۖ", "number_in_hafs": [46]}, {"chapter": 56, "verse": 50, "text": "وَكَانُواْ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَاباٗ وَعِظَٰماً اِنَّا لَمَبْعُوثُونَ", "number_in_hafs": [47]}, {"chapter": 56, "verse": 51, "text": "أَوَءَابَآؤُنَا اَ۬لَاوَّلُونَۖ", "number_in_hafs": [48]}, {"chapter": 56, "verse": 52, "text": "۞ قُلِ اِنَّ اَ۬لَاوَّلِينَ وَالَاخِرِينَ لَمَجْمُوعُونَ", "number_in_hafs": [49, 50]}, {"chapter": 56, "verse": 53, "text": "إِلَىٰ مِيقَٰتِ يَوْمٖ مَّعْلُومٖۖ", "number_in_hafs": [50]}, {"chapter": 56, "verse": 54, "text": "ثُمَّ إِنَّكُمُۥٓ أَيُّهَا اَ۬لضَّآلُّونَ اَ۬لْمُكَذِّبُونَ", "number_in_hafs": [51]}, {"chapter": 56, "verse": 55, "text": "لَأٓكِلُونَ مِن شَجَرٖ مِّن زَقُّومٖ", "number_in_hafs": [52]}, {"chapter": 56, "verse": 56, "text": "فَمَالِــُٔونَ مِنْهَا اَ۬لْبُطُونَ", "number_in_hafs": [53]}, {"chapter": 56, "verse": 57, "text": "فَشَٰرِبُونَ عَلَيْهِ مِنَ اَ۬لْحَمِيمِ", "number_in_hafs": [54]}, {"chapter": 56, "verse": 58, "text": "فَشَٰرِبُونَ شُرْبَ اَ۬لْهِيمِۖ", "number_in_hafs": [55]}, {"chapter": 56, "verse": 59, "text": "هَٰذَا نُزُلُهُمْ يَوْمَ اَ۬لدِّينِۖ", "number_in_hafs": [56]}, {"chapter": 56, "verse": 60, "text": "نَحْنُ خَلَقْنَٰكُمْۖ فَلَوْلَا تُصَدِّقُونَۖ", "number_in_hafs": [57]}, {"chapter": 56, "verse": 61, "text": "أَفَرَٰٓيْتُم مَّا تُمْنُونَ", "number_in_hafs": [58]}, {"chapter": 56, "verse": 62, "text": "ءَآنتُمْ تَخْلُقُونَهُۥٓ أَمْ نَحْنُ اُ۬لْخَٰلِقُونَۖ", "number_in_hafs": [59]}, {"chapter": 56, "verse": 63, "text": "نَحْنُ قَدَّرْنَا بَيْنَكُمُ اُ۬لْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ", "number_in_hafs": [60]}, {"chapter": 56, "verse": 64, "text": "عَلَىٰٓ أَن نُّبَدِّلَ أَمْثَٰلَكُمْ وَنُنشِيـَٔكُمْ فِے مَا لَا تَعْلَمُونَۖ", "number_in_hafs": [61]}, {"chapter": 56, "verse": 65, "text": "وَلَقَدْ عَلِمْتُمُ اُ۬لنَّشْأَةَ اَ۬لُاول۪ىٰۖ فَلَوْلَا تَذَّكَّرُونَۖ", "number_in_hafs": [62]}, {"chapter": 56, "verse": 66, "text": "أَفَرَٰٓيْتُم مَّا تَحْرُثُونَ", "number_in_hafs": [63]}, {"chapter": 56, "verse": 67, "text": "ءَآنتُمْ تَزْرَعُونَهُۥٓ أَمْ نَحْنُ اُ۬لزَّٰرِعُونَۖ", "number_in_hafs": [64]}, {"chapter": 56, "verse": 68, "text": "لَوْ نَشَآءُ لَجَعَلْنَٰهُ حُطَٰماٗ فَظَلْتُمْ تَفَكَّهُونَ", "number_in_hafs": [65]}, {"chapter": 56, "verse": 69, "text": "إِنَّا لَمُغْرَمُونَ", "number_in_hafs": [66]}, {"chapter": 56, "verse": 70, "text": "بَلْ نَحْنُ مَحْرُومُونَۖ", "number_in_hafs": [67]}, {"chapter": 56, "verse": 71, "text": "أَفَرَٰٓيْتُمُ اُ۬لْمَآءَ اَ۬لذِے تَشْرَبُونَ", "number_in_hafs": [68]}, {"chapter": 56, "verse": 72, "text": "ءَآنتُمُۥٓ أَنزَلْتُمُوهُ مِنَ اَ۬لْمُزْنِ أَمْ نَحْنُ اُ۬لْمُنزِلُونَۖ", "number_in_hafs": [69]}, {"chapter": 56, "verse": 73, "text": "لَوْ نَشَآءُ جَعَلْنَٰهُ أُجَاجاٗۖ فَلَوْلَا تَشْكُرُونَۖ", "number_in_hafs": [70]}, {"chapter": 56, "verse": 74, "text": "أَفَرَٰٓيْتُمُ اُ۬لنَّارَ اَ۬لتِے تُورُونَ", "number_in_hafs": [71]}, {"chapter": 56, "verse": 75, "text": "ءَآنتُمُۥٓ أَنشَأْتُمْ شَجَرَتَهَآ أَمْ نَحْنُ اُ۬لْمُنشِــُٔونَۖ", "number_in_hafs": [72]}, {"chapter": 56, "verse": 76, "text": "نَحْنُ جَعَلْنَٰهَا تَذْكِرَةٗ وَمَتَٰعاٗ لِّلْمُقْوِينَۖ", "number_in_hafs": [73]}, {"chapter": 56, "verse": 77, "text": "فَسَبِّحْ بِاسْمِ رَبِّكَ اَ۬لْعَظِيمِۖ", "number_in_hafs": [74]}, {"chapter": 56, "verse": 78, "text": "۞ فَلَآ أُقْسِمُ بِمَوَٰقِعِ اِ۬لنُّجُومِ", "number_in_hafs": [75]}, {"chapter": 56, "verse": 79, "text": "وَإِنَّهُۥ لَقَسَمٞ لَّوْ تَعْلَمُونَ عَظِيمٌ", "number_in_hafs": [76]}, {"chapter": 56, "verse": 80, "text": "اِنَّهُۥ لَقُرْءَانٞ كَرِيمٞ", "number_in_hafs": [77]}, {"chapter": 56, "verse": 81, "text": "فِے كِتَٰبٖ مَّكْنُونٖ", "number_in_hafs": [78]}, {"chapter": 56, "verse": 82, "text": "لَّا يَمَسُّهُۥٓ إِلَّا اَ۬لْمُطَهَّرُونَۖ", "number_in_hafs": [79]}, {"chapter": 56, "verse": 83, "text": "تَنزِيلٞ مِّن رَّبِّ اِ۬لْعَٰلَمِينَۖ", "number_in_hafs": [80]}, {"chapter": 56, "verse": 84, "text": "أَفَبِهَٰذَا اَ۬لْحَدِيثِ أَنتُم مُّدْهِنُونَ", "number_in_hafs": [81]}, {"chapter": 56, "verse": 85, "text": "وَتَجْعَلُونَ رِزْقَكُمُۥٓ أَنَّكُمْ تُكَذِّبُونَۖ", "number_in_hafs": [82]}, {"chapter": 56, "verse": 86, "text": "فَلَوْلَآ إِذَا بَلَغَتِ اِ۬لْحُلْقُومَ", "number_in_hafs": [83]}, {"chapter": 56, "verse": 87, "text": "وَأَنتُمْ حِينَئِذٖ تَنظُرُونَ", "number_in_hafs": [84]}, {"chapter": 56, "verse": 88, "text": "وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَٰكِن لَّا تُبْصِرُونَ", "number_in_hafs": [85]}, {"chapter": 56, "verse": 89, "text": "فَلَوْلَآ إِن كُنتُمْ غَيْرَ مَدِينِينَ", "number_in_hafs": [86]}, {"chapter": 56, "verse": 90, "text": "تَرْجِعُونَهَآ إِن كُنتُمْ صَٰدِقِينَۖ", "number_in_hafs": [87]}, {"chapter": 56, "verse": 91, "text": "فَأَمَّآ إِن كَانَ مِنَ اَ۬لْمُقَرَّبِينَ", "number_in_hafs": [88]}, {"chapter": 56, "verse": 92, "text": "فَرَوْحٞ وَرَيْحَانٞ وَجَنَّتُ نَعِيمٖۖ", "number_in_hafs": [89]}, {"chapter": 56, "verse": 93, "text": "وَأَمَّآ إِن كَانَ مِنَ اَصْحَٰبِ اِ۬لْيَمِينِ", "number_in_hafs": [90]}, {"chapter": 56, "verse": 94, "text": "فَسَلَٰمٞ لَّكَ مِنَ اَصْحَٰبِ اِ۬لْيَمِينِۖ", "number_in_hafs": [91]}, {"chapter": 56, "verse": 95, "text": "وَأَمَّآ إِن كَانَ مِنَ اَ۬لْمُكَذِّبِينَ اَ۬لضَّآلِّينَ", "number_in_hafs": [92]}, {"chapter": 56, "verse": 96, "text": "فَنُزُلٞ مِّنْ حَمِيمٖ", "number_in_hafs": [93]}, {"chapter": 56, "verse": 97, "text": "وَتَصْلِيَةُ جَحِيمٍۖ", "number_in_hafs": [94]}, {"chapter": 56, "verse": 98, "text": "اِنَّ هَٰذَا لَهُوَ حَقُّ اُ۬لْيَقِينِۖ", "number_in_hafs": [95]}, {"chapter": 56, "verse": 99, "text": "فَسَبِّحْ بِاسْمِ رَبِّكَ اَ۬لْعَظِيمِۖ", "number_in_hafs": [96]}]}