{"chapter": 94, "verses": [{"chapter": 94, "verse": 1, "text": "اَلَمْ نَشْرَحْ لَكَ صَدْرَكَ", "number_in_hafs": [1]}, {"chapter": 94, "verse": 2, "text": "وَوَضَعْنَا عَنكَ وِزْرَكَ", "number_in_hafs": [2]}, {"chapter": 94, "verse": 3, "text": "اَ۬لذِےٓ أَنقَضَ ظَهْرَكَ", "number_in_hafs": [3]}, {"chapter": 94, "verse": 4, "text": "وَرَفَعْنَا لَكَ ذِكْرَكَۖ", "number_in_hafs": [4]}, {"chapter": 94, "verse": 5, "text": "فَإِنَّ مَعَ اَ۬لْعُسْرِ يُسْراً", "number_in_hafs": [5]}, {"chapter": 94, "verse": 6, "text": "اِنَّ مَعَ اَ۬لْعُسْرِ يُسْراٗۖ", "number_in_hafs": [6]}, {"chapter": 94, "verse": 7, "text": "فَإِذَا فَرَغْتَ فَانصَبْ", "number_in_hafs": [7]}, {"chapter": 94, "verse": 8, "text": "وَإِلَىٰ رَبِّكَ فَارْغَبْۖ", "number_in_hafs": [8]}]}