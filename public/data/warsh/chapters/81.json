{"chapter": 81, "verses": [{"chapter": 81, "verse": 1, "text": "إِذَا اَ۬لشَّمْسُ كُوِّرَتْ", "number_in_hafs": [1]}, {"chapter": 81, "verse": 2, "text": "وَإِذَا اَ۬لنُّجُومُ اُ۪نكَدَرَتْ", "number_in_hafs": [2]}, {"chapter": 81, "verse": 3, "text": "وَإِذَا اَ۬لْجِبَالُ سُيِّرَتْ", "number_in_hafs": [3]}, {"chapter": 81, "verse": 4, "text": "وَإِذَا اَ۬لْعِشَارُ عُطِّلَتْ", "number_in_hafs": [4]}, {"chapter": 81, "verse": 5, "text": "وَإِذَا اَ۬لْوُحُوشُ حُشِرَتْ", "number_in_hafs": [5]}, {"chapter": 81, "verse": 6, "text": "وَإِذَا اَ۬لْبِحَارُ سُجِّرَتْ", "number_in_hafs": [6]}, {"chapter": 81, "verse": 7, "text": "وَإِذَا اَ۬لنُّفُوسُ زُوِّجَتْ", "number_in_hafs": [7]}, {"chapter": 81, "verse": 8, "text": "وَإِذَا اَ۬لْمَوْءُۥدَةُ سُئِلَتْ", "number_in_hafs": [8]}, {"chapter": 81, "verse": 9, "text": "بِأَيِّ ذَنۢبٖ قُتِلَتْ", "number_in_hafs": [9]}, {"chapter": 81, "verse": 10, "text": "وَإِذَا اَ۬لصُّحُفُ نُشِرَتْ", "number_in_hafs": [10]}, {"chapter": 81, "verse": 11, "text": "وَإِذَا اَ۬لسَّمَآءُ كُشِطَتْ", "number_in_hafs": [11]}, {"chapter": 81, "verse": 12, "text": "وَإِذَا اَ۬لْجَحِيمُ سُعِّرَتْ", "number_in_hafs": [12]}, {"chapter": 81, "verse": 13, "text": "وَإِذَا اَ۬لْجَنَّةُ أُزْلِفَتْ", "number_in_hafs": [13]}, {"chapter": 81, "verse": 14, "text": "عَلِمَتْ نَفْسٞ مَّآ أَحْضَرَتْۖ", "number_in_hafs": [14]}, {"chapter": 81, "verse": 15, "text": "فَلَآ أُقْسِمُ بِالْخُنَّسِ", "number_in_hafs": [15]}, {"chapter": 81, "verse": 16, "text": "اِ۬لْجَوَارِ اِ۬لْكُنَّسِ", "number_in_hafs": [16]}, {"chapter": 81, "verse": 17, "text": "وَاليْلِ إِذَا عَسْعَسَ", "number_in_hafs": [17]}, {"chapter": 81, "verse": 18, "text": "وَالصُّبْحِ إِذَا تَنَفَّسَ", "number_in_hafs": [18]}, {"chapter": 81, "verse": 19, "text": "إِنَّهُۥ لَقَوْلُ رَسُولٖ كَرِيمٖ", "number_in_hafs": [19]}, {"chapter": 81, "verse": 20, "text": "ذِے قُوَّةٍ عِندَ ذِے اِ۬لْعَرْشِ مَكِينٖ", "number_in_hafs": [20]}, {"chapter": 81, "verse": 21, "text": "مُّطَاعٖ ثَمَّ أَمِينٖۖ", "number_in_hafs": [21]}, {"chapter": 81, "verse": 22, "text": "وَمَا صَٰحِبُكُم بِمَجْنُونٖۖ", "number_in_hafs": [22]}, {"chapter": 81, "verse": 23, "text": "وَلَقَدْ ر۪ء۪اهُ بِالُافُقِ اِ۬لْمُبِينِۖ", "number_in_hafs": [23]}, {"chapter": 81, "verse": 24, "text": "وَمَا هُوَ عَلَى اَ۬لْغَيْبِ بِضَنِينٖۖ", "number_in_hafs": [24]}, {"chapter": 81, "verse": 25, "text": "وَمَا هُوَ بِقَوْلِ شَيْطَٰنٖ رَّجِيمٖ", "number_in_hafs": [25]}, {"chapter": 81, "verse": 26, "text": "فَأَيْنَ تَذْهَبُونَۖ", "number_in_hafs": [26]}, {"chapter": 81, "verse": 27, "text": "إِنْ هُوَ إِلَّا ذِكْرٞ لِّلْعَٰلَمِينَ", "number_in_hafs": [27]}, {"chapter": 81, "verse": 28, "text": "لِمَن شَآءَ مِنكُمُۥٓ أَنْ يَّسْتَقِيمَۖ", "number_in_hafs": [28]}, {"chapter": 81, "verse": 29, "text": "وَمَا تَشَآءُونَ إِلَّآ أَنْ يَّشَآءَ اَ۬للَّهُ رَبُّ اُ۬لْعَٰلَمِينَۖ", "number_in_hafs": [29]}]}