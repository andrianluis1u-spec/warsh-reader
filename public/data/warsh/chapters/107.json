{"chapter": 107, "verses": [{"chapter": 107, "verse": 1, "text": "اَرَٰٓيْتَ اَ۬لذِے يُكَذِّبُ بِالدِّينِ", "number_in_hafs": [1]}, {"chapter": 107, "verse": 2, "text": "فَذَٰلِكَ اَ۬لذِے يَدُعُّ اُ۬لْيَتِيمَ", "number_in_hafs": [2]}, {"chapter": 107, "verse": 3, "text": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ اِ۬لْمِسْكِينِۖ", "number_in_hafs": [3]}, {"chapter": 107, "verse": 4, "text": "فَوَيْلٞ لِّلْمُصَلِّينَ", "number_in_hafs": [4]}, {"chapter": 107, "verse": 5, "text": "اَ۬لذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ", "number_in_hafs": [5]}, {"chapter": 107, "verse": 6, "text": "اَ۬لذِينَ هُمْ يُرَآءُونَ وَيَمْنَعُونَ اَ۬لْمَاعُونَۖ", "number_in_hafs": [6, 7]}]}