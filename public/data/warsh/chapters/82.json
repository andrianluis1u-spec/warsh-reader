{"chapter": 82, "verses": [{"chapter": 82, "verse": 1, "text": "إِذَا اَ۬لسَّمَآءُ اُ۪نفَطَرَتْ", "number_in_hafs": [1]}, {"chapter": 82, "verse": 2, "text": "وَإِذَا اَ۬لْكَوَاكِبُ اُ۪نتَثَرَتْ", "number_in_hafs": [2]}, {"chapter": 82, "verse": 3, "text": "وَإِذَا اَ۬لْبِحَارُ فُجِّرَتْ", "number_in_hafs": [3]}, {"chapter": 82, "verse": 4, "text": "وَإِذَا اَ۬لْقُبُورُ بُعْثِرَتْ", "number_in_hafs": [4]}, {"chapter": 82, "verse": 5, "text": "عَلِمَتْ نَفْسٞ مَّا قَدَّمَتْ وَأَخَّرَتْۖ", "number_in_hafs": [5]}, {"chapter": 82, "verse": 6, "text": "يَٰٓأَيُّهَا اَ۬لِانسَٰنُ مَا غَرَّكَ بِرَبِّكَ اَ۬لْكَرِيمِ", "number_in_hafs": [6]}, {"chapter": 82, "verse": 7, "text": "اِ۬لذِے خَلَقَكَ فَسَوّ۪يٰكَ فَعَدَّلَكَ", "number_in_hafs": [7]}, {"chapter": 82, "verse": 8, "text": "فِےٓ أَيِّ صُورَةٖ مَّا شَآءَ رَكَّبَكَۖ", "number_in_hafs": [8]}, {"chapter": 82, "verse": 9, "text": "كَلَّا بَلْ تُكَذِّبُونَ بِالدِّينِ", "number_in_hafs": [9]}, {"chapter": 82, "verse": 10, "text": "وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ", "number_in_hafs": [10]}, {"chapter": 82, "verse": 11, "text": "كِرَاماٗ كَٰتِبِينَ", "number_in_hafs": [11]}, {"chapter": 82, "verse": 12, "text": "يَعْلَمُونَ مَا تَفْعَلُونَۖ", "number_in_hafs": [12]}, {"chapter": 82, "verse": 13, "text": "إِنَّ اَ۬لَابْرَارَ لَفِے نَعِيمٖۖ", "number_in_hafs": [13]}, {"chapter": 82, "verse": 14, "text": "وَإِنَّ اَ۬لْفُجَّارَ لَفِے جَحِيمٖ", "number_in_hafs": [14]}, {"chapter": 82, "verse": 15, "text": "يَصْلَوْنَهَا يَوْمَ اَ۬لدِّينِ", "number_in_hafs": [15]}, {"chapter": 82, "verse": 16, "text": "وَمَا هُمْ عَنْهَا بِغَآئِبِينَۖ", "number_in_hafs": [16]}, {"chapter": 82, "verse": 17, "text": "وَمَآ أَدْر۪يٰكَ مَا يَوْمُ اُ۬لدِّينِ", "number_in_hafs": [17]}, {"chapter": 82, "verse": 18, "text": "ثُمَّ مَآ أَدْر۪يٰكَ مَا يَوْمُ اُ۬لدِّينِۖ", "number_in_hafs": [18]}, {"chapter": 82, "verse": 19, "text": "يَوْمَ لَا تَمْلِكُ نَفْسٞ لِّنَفْسٖ شَيْــٔاٗۖ وَالَامْرُ يَوْمَئِذٖ لِّلهِۖ", "number_in_hafs": [19]}]}