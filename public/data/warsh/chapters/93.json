{"chapter": 93, "verses": [{"chapter": 93, "verse": 1, "text": "وَالضُّح۪ىٰ", "number_in_hafs": [1]}, {"chapter": 93, "verse": 2, "text": "وَاليْلِ إِذَا سَج۪ىٰ", "number_in_hafs": [2]}, {"chapter": 93, "verse": 3, "text": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَل۪ىٰۖ", "number_in_hafs": [3]}, {"chapter": 93, "verse": 4, "text": "وَلَلَاخِرَةُ خَيْرٞ لَّكَ مِنَ اَ۬لُاول۪ىٰۖ", "number_in_hafs": [4]}, {"chapter": 93, "verse": 5, "text": "وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْض۪ىٰٓۖ", "number_in_hafs": [5]}, {"chapter": 93, "verse": 6, "text": "أَلَمْ يَجِدْكَ يَتِيماٗ فَــَٔاو۪ىٰ", "number_in_hafs": [6]}, {"chapter": 93, "verse": 7, "text": "وَوَجَدَكَ ضَآلّاٗ فَهَد۪ىٰ", "number_in_hafs": [7]}, {"chapter": 93, "verse": 8, "text": "وَوَجَدَكَ عَآئِلاٗ فَأَغْن۪ىٰۖ", "number_in_hafs": [8]}, {"chapter": 93, "verse": 9, "text": "فَأَمَّا اَ۬لْيَتِيمَ فَلَا تَقْهَرْۖ", "number_in_hafs": [9]}, {"chapter": 93, "verse": 10, "text": "وَأَمَّا اَ۬لسَّآئِلَ فَلَا تَنْهَرْۖ", "number_in_hafs": [10]}, {"chapter": 93, "verse": 11, "text": "وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثَۖ", "number_in_hafs": [11]}]}