{"chapter": 85, "verses": [{"chapter": 85, "verse": 1, "text": "وَالسَّمَآءِ ذَاتِ اِ۬لْبُرُوجِ", "number_in_hafs": [1]}, {"chapter": 85, "verse": 2, "text": "وَالْيَوْمِ اِ۬لْمَوْعُودِ", "number_in_hafs": [2]}, {"chapter": 85, "verse": 3, "text": "وَشَاهِدٖ وَمَشْهُودٖ", "number_in_hafs": [3]}, {"chapter": 85, "verse": 4, "text": "قُتِلَ أَصْحَٰبُ اُ۬لُاخْدُودِ", "number_in_hafs": [4]}, {"chapter": 85, "verse": 5, "text": "اِ۬لنّ۪ارِ ذَاتِ اِ۬لْوَقُودِ", "number_in_hafs": [5]}, {"chapter": 85, "verse": 6, "text": "إِذْ هُمْ عَلَيْهَا قُعُودٞ", "number_in_hafs": [6]}, {"chapter": 85, "verse": 7, "text": "وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِالْمُومِنِينَ شُهُودٞۖ", "number_in_hafs": [7]}, {"chapter": 85, "verse": 8, "text": "وَمَا نَقَمُواْ مِنْهُمُۥٓ إِلَّآ أَنْ يُّومِنُواْ بِاللَّهِ اِ۬لْعَزِيزِ اِ۬لْحَمِيدِ", "number_in_hafs": [8]}, {"chapter": 85, "verse": 9, "text": "اِ۬لذِے لَهُۥ مُلْكُ اُ۬لسَّمَٰوَٰتِ وَالَارْضِۖ وَاللَّهُ عَلَىٰ كُلِّ شَےْءٖ شَهِيدٌۖ", "number_in_hafs": [9]}, {"chapter": 85, "verse": 10, "text": "اِنَّ اَ۬لذِينَ فَتَنُواْ اُ۬لْمُومِنِينَ وَالْمُومِنَٰتِ ثُمَّ لَمْ يَتُوبُواْ فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ اُ۬لْحَرِيقِۖ", "number_in_hafs": [10]}, {"chapter": 85, "verse": 11, "text": "إِنَّ اَ۬لذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ لَهُمْ جَنَّٰتٞ تَجْرِے مِن تَحْتِهَا اَ۬لَانْهَٰرُۖ ذَٰلِكَ اَ۬لْفَوْزُ اُ۬لْكَبِيرُۖ", "number_in_hafs": [11]}, {"chapter": 85, "verse": 12, "text": "۞ إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌۖ", "number_in_hafs": [12]}, {"chapter": 85, "verse": 13, "text": "اِنَّهُۥ هُوَ يُبْدِےـُٔ وَيُعِيدُۖ", "number_in_hafs": [13]}, {"chapter": 85, "verse": 14, "text": "وَهُوَ اَ۬لْغَفُورُ اُ۬لْوَدُودُ", "number_in_hafs": [14]}, {"chapter": 85, "verse": 15, "text": "ذُو اُ۬لْعَرْشِۖ اِ۬لْمَجِيدُ", "number_in_hafs": [15]}, {"chapter": 85, "verse": 16, "text": "فَعَّالٞ لِّمَا يُرِيدُۖ", "number_in_hafs": [16]}, {"chapter": 85, "verse": 17, "text": "هَلَ اَت۪يٰكَ حَدِيثُ اُ۬لْجُنُودِ", "number_in_hafs": [17]}, {"chapter": 85, "verse": 18, "text": "فِرْعَوْنَ وَثَمُودَۖ", "number_in_hafs": [18]}, {"chapter": 85, "verse": 19, "text": "بَلِ اِ۬لذِينَ كَفَرُواْ فِے تَكْذِيبٖ", "number_in_hafs": [19]}, {"chapter": 85, "verse": 20, "text": "وَاللَّهُ مِنْ وَّرَآئِهِم مُّحِيطُۢۖ", "number_in_hafs": [20]}, {"chapter": 85, "verse": 21, "text": "بَلْ هُوَ قُرْءَانٞ مَّجِيدٞ", "number_in_hafs": [21]}, {"chapter": 85, "verse": 22, "text": "فِے لَوْحٖ مَّحْفُوظٞۖ", "number_in_hafs": [22]}]}