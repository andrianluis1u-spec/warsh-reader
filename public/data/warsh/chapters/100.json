{"chapter": 100, "verses": [{"chapter": 100, "verse": 1, "text": "وَالْعَٰدِيَٰتِ ضَبْحاٗ", "number_in_hafs": [1]}, {"chapter": 100, "verse": 2, "text": "فَالْمُورِيَٰتِ قَدْحاٗ", "number_in_hafs": [2]}, {"chapter": 100, "verse": 3, "text": "فَالْمُغِيرَٰتِ صُبْحاٗ", "number_in_hafs": [3]}, {"chapter": 100, "verse": 4, "text": "فَأَثَرْنَ بِهِۦ نَقْعاٗ", "number_in_hafs": [4]}, {"chapter": 100, "verse": 5, "text": "فَوَسَطْنَ بِهِۦ جَمْعاً", "number_in_hafs": [5]}, {"chapter": 100, "verse": 6, "text": "اِنَّ اَ۬لِانسَٰنَ لِرَبِّهِۦ لَكَنُودٞ", "number_in_hafs": [6]}, {"chapter": 100, "verse": 7, "text": "وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٞ", "number_in_hafs": [7]}, {"chapter": 100, "verse": 8, "text": "وَإِنَّهُۥ لِحُبِّ اِ۬لْخَيْرِ لَشَدِيدٌۖ", "number_in_hafs": [8]}, {"chapter": 100, "verse": 9, "text": "۞ اَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِے اِ۬لْقُبُورِ", "number_in_hafs": [9]}, {"chapter": 100, "verse": 10, "text": "وَحُصِّلَ مَا فِے اِ۬لصُّدُورِ", "number_in_hafs": [10]}, {"chapter": 100, "verse": 11, "text": "إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٖ لَّخَبِيرٌۖ", "number_in_hafs": [11]}]}