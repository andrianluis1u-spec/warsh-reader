{"chapter": 89, "verses": [{"chapter": 89, "verse": 1, "text": "وَالْفَجْرِ", "number_in_hafs": [1]}, {"chapter": 89, "verse": 2, "text": "وَلَيَالٍ عَشْرٖ", "number_in_hafs": [2]}, {"chapter": 89, "verse": 3, "text": "وَالشَّفْعِ وَالْوَتْرِ", "number_in_hafs": [3]}, {"chapter": 89, "verse": 4, "text": "وَاليْلِ إِذَا يَسْرِۦ", "number_in_hafs": [4]}, {"chapter": 89, "verse": 5, "text": "هَلْ فِے ذَٰلِكَ قَسَمٞ لِّذِے حِجْرٍۖ", "number_in_hafs": [5]}, {"chapter": 89, "verse": 6, "text": "اَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ", "number_in_hafs": [6]}, {"chapter": 89, "verse": 7, "text": "اِرَمَ ذَاتِ اِ۬لْعِمَادِ", "number_in_hafs": [7]}, {"chapter": 89, "verse": 8, "text": "اِ۬لتِے لَمْ يُخْلَقْ مِثْلُهَا فِے اِ۬لْبِلَٰدِ", "number_in_hafs": [8]}, {"chapter": 89, "verse": 9, "text": "وَثَمُودَ اَ۬لذِينَ جَابُواْ اُ۬لصَّخْرَ بِالْوَادِۦ", "number_in_hafs": [9]}, {"chapter": 89, "verse": 10, "text": "وَفِرْعَوْنَ ذِے اِ۬لَاوْتَادِ", "number_in_hafs": [10]}, {"chapter": 89, "verse": 11, "text": "اِ۬لذِينَ طَغَوْاْ فِے اِ۬لْبِلَٰدِ", "number_in_hafs": [11]}, {"chapter": 89, "verse": 12, "text": "فَأَكْثَرُواْ فِيهَا اَ۬لْفَسَادَ", "number_in_hafs": [12]}, {"chapter": 89, "verse": 13, "text": "فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍۖ", "number_in_hafs": [13]}, {"chapter": 89, "verse": 14, "text": "اِنَّ رَبَّكَ لَبِالْمِرْصَادِۖ", "number_in_hafs": [14]}, {"chapter": 89, "verse": 15, "text": "فَأَمَّا اَ۬لِانسَٰنُ إِذَا مَا اَ۪بْتَل۪يٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ", "number_in_hafs": [15]}, {"chapter": 89, "verse": 16, "text": "فَيَقُولُ رَبِّيَ أَكْرَمَنِۦۖ", "number_in_hafs": [15]}, {"chapter": 89, "verse": 17, "text": "وَأَمَّآ إِذَا مَا اَ۪بْتَل۪يٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ", "number_in_hafs": [16]}, {"chapter": 89, "verse": 18, "text": "فَيَقُولُ رَبِّيَ أَهَٰنَنِۦ", "number_in_hafs": [16]}, {"chapter": 89, "verse": 19, "text": "كَلَّاۖ بَل لَّا تُكْرِمُونَ اَ۬لْيَتِيمَ", "number_in_hafs": [17]}, {"chapter": 89, "verse": 20, "text": "وَلَا تَحُضُّونَ عَلَىٰ طَعَامِ اِ۬لْمِسْكِينِ", "number_in_hafs": [18]}, {"chapter": 89, "verse": 21, "text": "وَتَاكُلُونَ اَ۬لتُّرَاثَ أَكْلاٗ لَّمّاٗ", "number_in_hafs": [19]}, {"chapter": 89, "verse": 22, "text": "وَتُحِبُّونَ اَ۬لْمَالَ حُبّاٗ جَمّاٗ", "number_in_hafs": [20]}, {"chapter": 89, "verse": 23, "text": "كَلَّآۖ إِذَا دُكَّتِ اِ۬لَارْضُ دَكّاٗ دَكّاٗ", "number_in_hafs": [21]}, {"chapter": 89, "verse": 24, "text": "وَجَآءَ رَبُّكَ وَالْمَلَكُ صَفّاٗ صَفّاٗ", "number_in_hafs": [22]}, {"chapter": 89, "verse": 25, "text": "وَجِےٓءَ يَوْمَئِذِۢ بِجَهَنَّمَ", "number_in_hafs": [23]}, {"chapter": 89, "verse": 26, "text": "يَوْمَئِذٖ يَتَذَكَّرُ اُ۬لِانسَٰنُ وَأَنّ۪ىٰ لَهُ اُ۬لذِّكْر۪ىٰۖ", "number_in_hafs": [23]}, {"chapter": 89, "verse": 27, "text": "يَقُولُ يَٰلَيْتَنِے قَدَّمْتُ لِحَيَاتِےۖ", "number_in_hafs": [24]}, {"chapter": 89, "verse": 28, "text": "فَيَوْمَئِذٖ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٞ", "number_in_hafs": [25]}, {"chapter": 89, "verse": 29, "text": "وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٞۖ", "number_in_hafs": [26]}, {"chapter": 89, "verse": 30, "text": "يَٰٓأَيَّتُهَا اَ۬لنَّفْسُ اُ۬لْمُطْمَئِنَّةُ", "number_in_hafs": [27]}, {"chapter": 89, "verse": 31, "text": "اُ۪رْجِعِےٓ إِلَىٰ رَبِّكِ رَاضِيَةٗ مَّرْضِيَّةٗ", "number_in_hafs": [28]}, {"chapter": 89, "verse": 32, "text": "فَادْخُلِے فِے عِبَٰدِے وَادْخُلِے جَنَّتِےۖ", "number_in_hafs": [29, 30]}]}