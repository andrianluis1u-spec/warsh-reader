{"chapter": 91, "verses": [{"chapter": 91, "verse": 1, "text": "وَالشَّمْسِ وَضُحَيٰهَا", "number_in_hafs": [1]}, {"chapter": 91, "verse": 2, "text": "وَالْقَمَرِ إِذَا تَلَيٰهَا", "number_in_hafs": [2]}, {"chapter": 91, "verse": 3, "text": "وَالنَّه۪ارِ إِذَا جَلَّيٰهَا", "number_in_hafs": [3]}, {"chapter": 91, "verse": 4, "text": "وَاليْلِ إِذَا يَغْشَيٰهَا", "number_in_hafs": [4]}, {"chapter": 91, "verse": 5, "text": "وَالسَّمَآءِ وَمَا بَنَيٰهَا", "number_in_hafs": [5]}, {"chapter": 91, "verse": 6, "text": "وَالَارْضِ وَمَا طَحَيٰهَا", "number_in_hafs": [6]}, {"chapter": 91, "verse": 7, "text": "وَنَفْسٖ وَمَا سَوَّيٰهَا", "number_in_hafs": [7]}, {"chapter": 91, "verse": 8, "text": "فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَيٰهَا", "number_in_hafs": [8]}, {"chapter": 91, "verse": 9, "text": "قَدَ اَفْلَحَ مَن زَكَّيٰهَا", "number_in_hafs": [9]}, {"chapter": 91, "verse": 10, "text": "وَقَدْ خَابَ مَن دَسَّيٰهَاۖ", "number_in_hafs": [10]}, {"chapter": 91, "verse": 11, "text": "كَذَّبَتْ ثَمُودُ بِطَغْوَيٰهَآ", "number_in_hafs": [11]}, {"chapter": 91, "verse": 12, "text": "إِذِ اِ۪نۢبَعَثَ أَشْقَيٰهَا", "number_in_hafs": [12]}, {"chapter": 91, "verse": 13, "text": "فَقَالَ لَهُمْ رَسُولُ اُ۬للَّهِ نَاقَةَ اَ۬للَّهِ وَسُقْيَاهَا", "number_in_hafs": [13]}, {"chapter": 91, "verse": 14, "text": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّيٰهَاۖ", "number_in_hafs": [14]}, {"chapter": 91, "verse": 15, "text": "فَلَا يَخَافُ عُقْبَٰهَاۖ", "number_in_hafs": [15]}]}