{"chapter": 83, "verses": [{"chapter": 83, "verse": 1, "text": "وَيْلٞ لِّلْمُطَفِّفِينَ", "number_in_hafs": [1]}, {"chapter": 83, "verse": 2, "text": "اَ۬لذِينَ إِذَا اَ۪كْتَالُواْ عَلَى اَ۬لنَّاسِ يَسْتَوْفُونَ", "number_in_hafs": [2]}, {"chapter": 83, "verse": 3, "text": "وَإِذَا كَالُوهُمُۥٓ أَو وَّزَنُوهُمْ يُخْسِرُونَۖ", "number_in_hafs": [3]}, {"chapter": 83, "verse": 4, "text": "أَلَا يَظُنُّ أُوْلَٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ", "number_in_hafs": [4]}, {"chapter": 83, "verse": 5, "text": "لِيَوْمٍ عَظِيمٖ", "number_in_hafs": [5]}, {"chapter": 83, "verse": 6, "text": "يَوْمَ يَقُومُ اُ۬لنَّاسُ لِرَبِّ اِ۬لْعَٰلَمِينَۖ", "number_in_hafs": [6]}, {"chapter": 83, "verse": 7, "text": "كَلَّآ إِنَّ كِتَٰبَ اَ۬لْفُجّ۪ارِ لَفِے سِجِّينٖۖ", "number_in_hafs": [7]}, {"chapter": 83, "verse": 8, "text": "وَمَآ أَدْر۪يٰكَ مَا سِجِّينٞ", "number_in_hafs": [8]}, {"chapter": 83, "verse": 9, "text": "كِتَٰبٞ مَّرْقُومٞۖ", "number_in_hafs": [9]}, {"chapter": 83, "verse": 10, "text": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَ", "number_in_hafs": [10]}, {"chapter": 83, "verse": 11, "text": "اَ۬لذِينَ يُكَذِّبُونَ بِيَوْمِ اِ۬لدِّينِۖ", "number_in_hafs": [11]}, {"chapter": 83, "verse": 12, "text": "وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعْتَدٍ اَثِيمٍ", "number_in_hafs": [12]}, {"chapter": 83, "verse": 13, "text": "اِذَا تُتْل۪ىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ اُ۬لَاوَّلِينَۖ", "number_in_hafs": [13]}, {"chapter": 83, "verse": 14, "text": "۞ كَلَّا بَل رَّانَ عَلَىٰ قُلُوبِهِم مَّا كَانُواْ يَكْسِبُونَۖ", "number_in_hafs": [14]}, {"chapter": 83, "verse": 15, "text": "كَلَّآ إِنَّهُمْ عَن رَّبِّهِمْ يَوْمَئِذٖ لَّمَحْجُوبُونَۖ", "number_in_hafs": [15]}, {"chapter": 83, "verse": 16, "text": "ثُمَّ إِنَّهُمْ لَصَالُواْ اُ۬لْجَحِيمِۖ", "number_in_hafs": [16]}, {"chapter": 83, "verse": 17, "text": "ثُمَّ يُقَالُ هَٰذَا اَ۬لذِے كُنتُم بِهِۦ تُكَذِّبُونَۖ", "number_in_hafs": [17]}, {"chapter": 83, "verse": 18, "text": "كَلَّآ إِنَّ كِتَٰبَ اَ۬لَابْر۪ارِ لَفِے عِلِّيِّينَۖ", "number_in_hafs": [18]}, {"chapter": 83, "verse": 19, "text": "وَمَآ أَدْر۪يٰكَ مَا عِلِّيُّونَ", "number_in_hafs": [19]}, {"chapter": 83, "verse": 20, "text": "كِتَٰبٞ مَّرْقُومٞ", "number_in_hafs": [20]}, {"chapter": 83, "verse": 21, "text": "يَشْهَدُهُ اُ۬لْمُقَرَّبُونَۖ", "number_in_hafs": [21]}, {"chapter": 83, "verse": 22, "text": "إِنَّ اَ۬لَابْرَارَ لَفِے نَعِيمٍ", "number_in_hafs": [22]}, {"chapter": 83, "verse": 23, "text": "عَلَى اَ۬لَارَآئِكِ يَنظُرُونَ", "number_in_hafs": [23]}, {"chapter": 83, "verse": 24, "text": "تَعْرِفُ فِے وُجُوهِهِمْ نَضْرَةَ اَ۬لنَّعِيمِ", "number_in_hafs": [24]}, {"chapter": 83, "verse": 25, "text": "يُسْقَوْنَ مِن رَّحِيقٖ مَّخْتُومٍ", "number_in_hafs": [25]}, {"chapter": 83, "verse": 26, "text": "خِتَٰمُهُۥ مِسْكٞۖ وَفِے ذَٰلِكَ فَلْيَتَنَافَسِ اِ۬لْمُتَنَٰفِسُونَۖ", "number_in_hafs": [26]}, {"chapter": 83, "verse": 27, "text": "وَمِزَاجُهُۥ مِن تَسْنِيمٍ", "number_in_hafs": [27]}, {"chapter": 83, "verse": 28, "text": "عَيْناٗ يَشْرَبُ بِهَا اَ۬لْمُقَرَّبُونَۖ", "number_in_hafs": [28]}, {"chapter": 83, "verse": 29, "text": "إِنَّ اَ۬لذِينَ أَجْرَمُواْ كَانُواْ مِنَ اَ۬لذِينَ ءَامَنُواْ يَضْحَكُونَ", "number_in_hafs": [29]}, {"chapter": 83, "verse": 30, "text": "وَإِذَا مَرُّواْ بِهِمْ يَتَغَامَزُونَ", "number_in_hafs": [30]}, {"chapter": 83, "verse": 31, "text": "وَإِذَا اَ۪نقَلَبُوٓاْ إِلَىٰٓ أَهْلِهِمُ اُ۪نقَلَبُواْ فَٰكِهِينَ", "number_in_hafs": [31]}, {"chapter": 83, "verse": 32, "text": "وَإِذَا رَأَوْهُمْ قَالُوٓاْ إِنَّ هَٰٓؤُلَآءِ لَضَآلُّونَ", "number_in_hafs": [32]}, {"chapter": 83, "verse": 33, "text": "وَمَآ أُرْسِلُواْ عَلَيْهِمْ حَٰفِظِينَۖ", "number_in_hafs": [33]}, {"chapter": 83, "verse": 34, "text": "فَالْيَوْمَ اَ۬لذِينَ ءَامَنُواْ مِنَ اَ۬لْكُفّ۪ارِ يَضْحَكُونَ", "number_in_hafs": [34]}, {"chapter": 83, "verse": 35, "text": "عَلَى اَ۬لَارَآئِكِۖ يَنظُرُونَ", "number_in_hafs": [35]}, {"chapter": 83, "verse": 36, "text": "هَلْ ثُوِّبَ اَ۬لْكُفَّارُ مَا كَانُواْ يَفْعَلُونَۖ", "number_in_hafs": [36]}]}