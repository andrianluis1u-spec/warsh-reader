{"chapter": 55, "verses": [{"chapter": 55, "verse": 1, "text": "اِ۬لرَّحْمَٰنُ عَلَّمَ اَ۬لْقُرْءَانَۖ", "number_in_hafs": [1, 2]}, {"chapter": 55, "verse": 2, "text": "خَلَقَ اَ۬لِانسَٰنَ عَلَّمَهُ اُ۬لْبَيَانَۖ", "number_in_hafs": [3, 4]}, {"chapter": 55, "verse": 3, "text": "اَ۬لشَّمْسُ وَالْقَمَرُ بِحُسْبَانٖۖ", "number_in_hafs": [5]}, {"chapter": 55, "verse": 4, "text": "وَالنَّجْمُ وَالشَّجَرُ يَسْجُدَٰنِۖ", "number_in_hafs": [6]}, {"chapter": 55, "verse": 5, "text": "وَالسَّمَآءَ رَفَعَهَا وَوَضَعَ اَ۬لْمِيزَانَ", "number_in_hafs": [7]}, {"chapter": 55, "verse": 6, "text": "أَلَّا تَطْغَوْاْ فِے اِ۬لْمِيزَانِ", "number_in_hafs": [8]}, {"chapter": 55, "verse": 7, "text": "وَأَقِيمُواْ اُ۬لْوَزْنَ بِالْقِسْطِ وَلَا تُخْسِرُواْ اُ۬لْمِيزَانَۖ", "number_in_hafs": [9]}, {"chapter": 55, "verse": 8, "text": "وَالَارْضَ وَضَعَهَا لِلَانَامِ", "number_in_hafs": [10]}, {"chapter": 55, "verse": 9, "text": "فِيهَا فَٰكِهَةٞ وَالنَّخْلُ ذَاتُ اُ۬لَاكْمَامِ", "number_in_hafs": [11]}, {"chapter": 55, "verse": 10, "text": "وَالْحَبُّ ذُو اُ۬لْعَصْفِ وَالرَّيْحَانُۖ", "number_in_hafs": [12]}, {"chapter": 55, "verse": 11, "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ", "number_in_hafs": [13]}, {"chapter": 55, "verse": 12, "text": "خَلَقَ اَ۬لِانسَٰنَ مِن صَلْصَٰلٖ كَالْفَخّ۪ارِ", "number_in_hafs": [14]}, {"chapter": 55, "verse": 13, "text": "وَخَلَقَ اَ۬لْجَآنَّ مِن مَّارِجٖ مِّن نّ۪ارٖۖ", "number_in_hafs": [15]}, {"chapter": 55, "verse": 14, "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ", "number_in_hafs": [16]}, {"chapter": 55, "verse": 15, "text": "رَبُّ اُ۬لْمَشْرِقَيْنِ وَرَبُّ اُ۬لْمَغْرِبَيْنِۖ", "number_in_hafs": [17]}, {"chapter": 55, "verse": 16, "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ", "number_in_hafs": [18]}, {"chapter": 55, "verse": 17, "text": "مَرَجَ اَ۬لْبَحْرَيْنِ يَلْتَقِيَٰنِ", "number_in_hafs": [19]}, {"chapter": 55, "verse": 18, "text": "بَيْنَهُمَا بَرْزَخٞ لَّا يَبْغِيَٰنِۖ", "number_in_hafs": [20]}, {"chapter": 55, "verse": 19, "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ", "number_in_hafs": [21]}, {"chapter": 55, "verse": 20, "text": "يُخْرَجُ مِنْهُمَا اَ۬للُّؤْلُؤُاْ وَالْمَرْجَانُۖ", "number_in_hafs": [22]}, {"chapter": 55, "verse": 21, "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ", "number_in_hafs": [23]}, {"chapter": 55, "verse": 22, "text": "وَلَهُ اُ۬لْجَوَارِ اِ۬لْمُنشَأَٰتُ فِے اِ۬لْبَحْرِ كَالَاعْلَٰمِۖ", "number_in_hafs": [24]}, {"chapter": 55, "verse": 23, "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ", "number_in_hafs": [25]}, {"chapter": 55, "verse": 24, "text": "كُلُّ مَنْ عَلَيْهَا فَانٖ", "number_in_hafs": [26]}, {"chapter": 55, "verse": 25, "text": "وَيَبْق۪ىٰ وَجْهُ رَبِّكَ ذُو اُ۬لْجَلَٰلِ وَالِاكْرَامِۖ", "number_in_hafs": [27]}, {"chapter": 55, "verse": 26, "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ", "number_in_hafs": [28]}, {"chapter": 55, "verse": 27, "text": "يَسْــَٔلُهُۥ مَن فِے اِ۬لسَّمَٰوَٰتِ وَالَارْضِ كُلَّ يَوْمٍ هُوَ فِے شَأْنٖۖ", "number_in_hafs": [29]}, {"chapter": 55, "verse": 28, "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ", "number_in_hafs": [30]}, {"chapter": 55, "verse": 29, "text": "سَنَفْرُغُ لَكُمُۥٓ أَيُّهَ اَ۬لثَّقَلَٰنِۖ", "number_in_hafs": [31]}, {"chapter": 55, "verse": 30, "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ", "number_in_hafs": [32]}, {"chapter": 55, "verse": 31, "text": "يَٰمَعْشَرَ اَ۬لْجِنِّ وَالِانسِ إِنِ اِ۪سْتَطَعْتُمُۥٓ أَن تَنفُذُواْ مِنَ اَقْط۪ارِ اِ۬لسَّمَٰوَٰتِ وَالَارْضِ فَانفُذُواْۖ لَا تَنفُذُونَ إِلَّا بِسُلْطَٰنٖۖ", "number_in_hafs": [33]}, {"chapter": 55, "verse": 32, "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ", "number_in_hafs": [34]}, {"chapter": 55, "verse": 33, "text": "يُرْسَلُ عَلَيْكُمَا شُوَاظٞ مِّن نّ۪ارٖ", "number_in_hafs": [35]}, {"chapter": 55, "verse": 34, "text": "وَنُحَاسٞ فَلَا تَنتَصِرَٰنِۖ", "number_in_hafs": [35]}, {"chapter": 55, "verse": 35, "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ", "number_in_hafs": [36]}, {"chapter": 55, "verse": 36, "text": "فَإِذَا اَ۪نشَقَّتِ اِ۬لسَّمَآءُ فَكَانَتْ وَرْدَةٗ كَالدِّهَانِ", "number_in_hafs": [37]}, {"chapter": 55, "verse": 37, "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "number_in_hafs": [38]}, {"chapter": 55, "verse": 38, "text": "فَيَوْمَئِذٖ لَّا يُسْــَٔلُ عَن ذَنۢبِهِۦٓ إِنسٞ وَلَا جَآنّٞۖ", "number_in_hafs": [39]}, {"chapter": 55, "verse": 39, "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ", "number_in_hafs": [40]}, {"chapter": 55, "verse": 40, "text": "۞ يُعْرَفُ اُ۬لْمُجْرِمُونَ بِسِيمٰ۪هُمْ فَيُوخَذُ بِالنَّوَٰصِے وَالَاقْدَامِۖ", "number_in_hafs": [41]}, {"chapter": 55, "verse": 41, "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ", "number_in_hafs": [42]}, {"chapter": 55, "verse": 42, "text": "هَٰذِهِۦ جَهَنَّمُ اُ۬لتِے يُكَذِّبُ بِهَا اَ۬لْمُجْرِمُونَ", "number_in_hafs": [43]}, {"chapter": 55, "verse": 43, "text": "يَطُوفُونَ بَيْنَهَا وَبَيْنَ حَمِيمٍ اٰنٖۖ", "number_in_hafs": [44]}, {"chapter": 55, "verse": 44, "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ", "number_in_hafs": [45]}, {"chapter": 55, "verse": 45, "text": "وَلِمَنْ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَٰنِ", "number_in_hafs": [46]}, {"chapter": 55, "verse": 46, "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "number_in_hafs": [47]}, {"chapter": 55, "verse": 47, "text": "ذَوَاتَآ أَفْنَانٖۖ", "number_in_hafs": [48]}, {"chapter": 55, "verse": 48, "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ", "number_in_hafs": [49]}, {"chapter": 55, "verse": 49, "text": "فِيهِمَا عَيْنَٰنِ تَجْرِيَٰنِۖ", "number_in_hafs": [50]}, {"chapter": 55, "verse": 50, "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ", "number_in_hafs": [51]}, {"chapter": 55, "verse": 51, "text": "فِيهِمَا مِن كُلِّ فَٰكِهَةٖ زَوْجَٰنِۖ", "number_in_hafs": [52]}, {"chapter": 55, "verse": 52, "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ", "number_in_hafs": [53]}, {"chapter": 55, "verse": 53, "text": "مُتَّكِـِٕينَ عَلَىٰ فُرُشِۢ بَطَآئِنُهَا مِنِ اِسْتَبْرَقٖ وَجَنَا اَ۬لْجَنَّتَيْنِ دَانٖۖ", "number_in_hafs": [54]}, {"chapter": 55, "verse": 54, "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ", "number_in_hafs": [55]}, {"chapter": 55, "verse": 55, "text": "فِيهِنَّ قَٰصِرَٰتُ اُ۬لطَّرْفِ لَمْ يَطْمِثْهُنَّ إِنسٞ قَبْلَهُمْ وَلَا جَآنّٞۖ", "number_in_hafs": [56]}, {"chapter": 55, "verse": 56, "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ", "number_in_hafs": [57]}, {"chapter": 55, "verse": 57, "text": "كَأَنَّهُنَّ اَ۬لْيَاقُوتُ وَالْمَرْجَانُۖ", "number_in_hafs": [58]}, {"chapter": 55, "verse": 58, "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ", "number_in_hafs": [59]}, {"chapter": 55, "verse": 59, "text": "هَلْ جَزَآءُ اُ۬لِاحْسَٰنِ إِلَّا اَ۬لِاحْسَٰنُۖ", "number_in_hafs": [60]}, {"chapter": 55, "verse": 60, "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ", "number_in_hafs": [61]}, {"chapter": 55, "verse": 61, "text": "وَمِن دُونِهِمَا جَنَّتَٰنِ", "number_in_hafs": [62]}, {"chapter": 55, "verse": 62, "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "number_in_hafs": [63]}, {"chapter": 55, "verse": 63, "text": "مُدْهَآمَّتَٰنِۖ", "number_in_hafs": [64]}, {"chapter": 55, "verse": 64, "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ", "number_in_hafs": [65]}, {"chapter": 55, "verse": 65, "text": "فِيهِمَا عَيْنَٰنِ نَضَّاخَتَٰنِۖ", "number_in_hafs": [66]}, {"chapter": 55, "verse": 66, "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ", "number_in_hafs": [67]}, {"chapter": 55, "verse": 67, "text": "فِيهِمَا فَٰكِهَةٞ وَنَخْلٞ وَرُمَّانٞۖ", "number_in_hafs": [68]}, {"chapter": 55, "verse": 68, "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ", "number_in_hafs": [69]}, {"chapter": 55, "verse": 69, "text": "فِيهِنَّ خَيْرَٰتٌ حِسَانٞۖ", "number_in_hafs": [70]}, {"chapter": 55, "verse": 70, "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ", "number_in_hafs": [71]}, {"chapter": 55, "verse": 71, "text": "حُورٞ مَّقْصُورَٰتٞ فِے اِ۬لْخِيَامِۖ", "number_in_hafs": [72]}, {"chapter": 55, "verse": 72, "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ", "number_in_hafs": [73]}, {"chapter": 55, "verse": 73, "text": "لَمْ يَطْمِثْهُنَّ إِنسٞ قَبْلَهُمْ وَلَا جَآنّٞۖ", "number_in_hafs": [74]}, {"chapter": 55, "verse": 74, "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ", "number_in_hafs": [75]}, {"chapter": 55, "verse": 75, "text": "مُتَّكِـِٕينَ عَلَىٰ رَفْرَفٍ خُضْرٖ وَعَبْقَرِيٍّ حِسَانٖۖ", "number_in_hafs": [76]}, {"chapter": 55, "verse": 76, "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ", "number_in_hafs": [77]}, {"chapter": 55, "verse": 77, "text": "تَبَٰرَكَ اَ۪سْمُ رَبِّكَ ذِے اِ۬لْجَلَٰلِ وَالِاكْرَامِۖ", "number_in_hafs": [78]}]}