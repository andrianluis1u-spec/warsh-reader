{"chapter": 79, "verses": [{"chapter": 79, "verse": 1, "text": "وَالنَّٰزِعَٰتِ غَرْقاٗ", "number_in_hafs": [1]}, {"chapter": 79, "verse": 2, "text": "وَالنَّٰشِطَٰتِ نَشْطاٗ", "number_in_hafs": [2]}, {"chapter": 79, "verse": 3, "text": "وَالسَّٰبِحَٰتِ سَبْحاٗ", "number_in_hafs": [3]}, {"chapter": 79, "verse": 4, "text": "فَالسَّٰبِقَٰتِ سَبْقاٗ", "number_in_hafs": [4]}, {"chapter": 79, "verse": 5, "text": "فَالْمُدَبِّرَٰتِ أَمْراٗ", "number_in_hafs": [5]}, {"chapter": 79, "verse": 6, "text": "يَوْمَ تَرْجُفُ اُ۬لرَّاجِفَةُ", "number_in_hafs": [6]}, {"chapter": 79, "verse": 7, "text": "تَتْبَعُهَا اَ۬لرَّادِفَةُۖ", "number_in_hafs": [7]}, {"chapter": 79, "verse": 8, "text": "قُلُوبٞ يَوْمَئِذٖ وَاجِفَةٌ", "number_in_hafs": [8]}, {"chapter": 79, "verse": 9, "text": "اَبْصَٰرُهَا خَٰشِعَةٞۖ", "number_in_hafs": [9]}, {"chapter": 79, "verse": 10, "text": "يَقُولُونَ أَ۟نَّا لَمَرْدُودُونَ فِے اِ۬لْحَافِرَةِ", "number_in_hafs": [10]}, {"chapter": 79, "verse": 11, "text": "إِذَا كُنَّا عِظَٰماٗ نَّخِرَةٗۖ", "number_in_hafs": [11]}, {"chapter": 79, "verse": 12, "text": "قَالُواْ تِلْكَ إِذاٗ كَرَّةٌ خَاسِرَةٞ", "number_in_hafs": [12]}, {"chapter": 79, "verse": 13, "text": "فَإِنَّمَا هِيَ زَجْرَةٞ وَٰحِدَةٞ", "number_in_hafs": [13]}, {"chapter": 79, "verse": 14, "text": "فَإِذَا هُم بِالسَّاهِرَةِۖ", "number_in_hafs": [14]}, {"chapter": 79, "verse": 15, "text": "هَلَ اَت۪يٰكَ حَدِيثُ مُوس۪ىٰٓ", "number_in_hafs": [15]}, {"chapter": 79, "verse": 16, "text": "إِذْ نَاد۪يٰهُ رَبُّهُۥ بِالْوَادِ اِ۬لْمُقَدَّسِ طُوَىۖ", "number_in_hafs": [16]}, {"chapter": 79, "verse": 17, "text": "اَ۪ذْهَبِ اِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغ۪ىٰ", "number_in_hafs": [17]}, {"chapter": 79, "verse": 18, "text": "فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَّكّ۪ىٰ", "number_in_hafs": [18]}, {"chapter": 79, "verse": 19, "text": "وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْش۪ىٰۖ", "number_in_hafs": [19]}, {"chapter": 79, "verse": 20, "text": "فَأَر۪يٰهُ اُ۬لَايَةَ اَ۬لْكُبْر۪ىٰ", "number_in_hafs": [20]}, {"chapter": 79, "verse": 21, "text": "فَكَذَّبَ وَعَص۪ىٰ", "number_in_hafs": [21]}, {"chapter": 79, "verse": 22, "text": "ثُمَّ أَدْبَرَ يَسْع۪ىٰ", "number_in_hafs": [22]}, {"chapter": 79, "verse": 23, "text": "فَحَشَرَ فَنَاد۪ىٰ", "number_in_hafs": [23]}, {"chapter": 79, "verse": 24, "text": "فَقَالَ أَنَا رَبُّكُمُ اُ۬لَاعْل۪ىٰ", "number_in_hafs": [24]}, {"chapter": 79, "verse": 25, "text": "فَأَخَذَهُ اُ۬للَّهُ نَكَالَ اَ۬لَاخِرَةِ وَالُاول۪ىٰٓۖ", "number_in_hafs": [25]}, {"chapter": 79, "verse": 26, "text": "إِنَّ فِے ذَٰلِكَ لَعِبْرَةٗ لِّمَنْ يَّخْش۪ىٰٓۖ", "number_in_hafs": [26]}, {"chapter": 79, "verse": 27, "text": "ءَآنتُمُۥٓ أَشَدُّ خَلْقاً اَمِ اِ۬لسَّمَآءُۖ بَنَيٰهَا", "number_in_hafs": [27]}, {"chapter": 79, "verse": 28, "text": "رَفَعَ سَمْكَهَا فَسَوَّيٰهَا", "number_in_hafs": [28]}, {"chapter": 79, "verse": 29, "text": "وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَيٰهَاۖ", "number_in_hafs": [29]}, {"chapter": 79, "verse": 30, "text": "وَالَارْضَ بَعْدَ ذَٰلِكَ دَحَيٰهَآ", "number_in_hafs": [30]}, {"chapter": 79, "verse": 31, "text": "أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَيٰهَا", "number_in_hafs": [31]}, {"chapter": 79, "verse": 32, "text": "وَالْجِبَالَ أَرْسَيٰهَا", "number_in_hafs": [32]}, {"chapter": 79, "verse": 33, "text": "مَتَٰعاٗ لَّكُمْ وَلِأَنْعَٰمِكُمْۖ", "number_in_hafs": [33]}, {"chapter": 79, "verse": 34, "text": "فَإِذَا جَآءَتِ اِ۬لطَّآمَّةُ اُ۬لْكُبْر۪ىٰ", "number_in_hafs": [34]}, {"chapter": 79, "verse": 35, "text": "يَوْمَ يَتَذَكَّرُ اُ۬لِانسَٰنُ مَا سَع۪ىٰ", "number_in_hafs": [35]}, {"chapter": 79, "verse": 36, "text": "وَبُرِّزَتِ اِ۬لْجَحِيمُ لِمَنْ يَّر۪ىٰۖ", "number_in_hafs": [36]}, {"chapter": 79, "verse": 37, "text": "فَأَمَّا مَن طَغ۪ىٰ وَءَاثَرَ اَ۬لْحَيَوٰةَ اَ۬لدُّنْي۪ا", "number_in_hafs": [37, 38]}, {"chapter": 79, "verse": 38, "text": "فَإِنَّ اَ۬لْجَحِيمَ هِيَ اَ۬لْمَأْو۪ىٰۖ", "number_in_hafs": [39]}, {"chapter": 79, "verse": 39, "text": "وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى اَ۬لنَّفْسَ عَنِ اِ۬لْهَو۪ىٰ", "number_in_hafs": [40]}, {"chapter": 79, "verse": 40, "text": "فَإِنَّ اَ۬لْجَنَّةَ هِيَ اَ۬لْمَأْو۪ىٰۖ", "number_in_hafs": [41]}, {"chapter": 79, "verse": 41, "text": "۞ يَسْــَٔلُونَكَ عَنِ اِ۬لسَّاعَةِ أَيَّانَ مُرْسَيٰهَاۖ", "number_in_hafs": [42]}, {"chapter": 79, "verse": 42, "text": "فِيمَ أَنتَ مِن ذِكْر۪يٰهَآۖ", "number_in_hafs": [43]}, {"chapter": 79, "verse": 43, "text": "إِلَىٰ رَبِّكَ مُنتَهَيٰهَآۖ", "number_in_hafs": [44]}, {"chapter": 79, "verse": 44, "text": "إِنَّمَآ أَنتَ مُنذِرُ مَنْ يَّخْشَيٰهَاۖ", "number_in_hafs": [45]}, {"chapter": 79, "verse": 45, "text": "كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓاْ إِلَّا عَشِيَّةً اَوْ ضُحَيٰهَاۖ", "number_in_hafs": [46]}]}