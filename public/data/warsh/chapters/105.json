{"chapter": 105, "verses": [{"chapter": 105, "verse": 1, "text": "اَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَٰبِ اِ۬لْفِيلِۖ", "number_in_hafs": [1]}, {"chapter": 105, "verse": 2, "text": "أَلَمْ يَجْعَلْ كَيْدَهُمْ فِے تَضْلِيلٖ", "number_in_hafs": [2]}, {"chapter": 105, "verse": 3, "text": "وَأَرْسَلَ عَلَيْهِمْ طَيْراً اَبَابِيلَ", "number_in_hafs": [3]}, {"chapter": 105, "verse": 4, "text": "تَرْمِيهِم بِحِجَارَةٖ مِّن سِجِّيلٖ", "number_in_hafs": [4]}, {"chapter": 105, "verse": 5, "text": "فَجَعَلَهُمْ كَعَصْفٖ مَّاكُولٖۖ", "number_in_hafs": [5]}]}