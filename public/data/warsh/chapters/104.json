{"chapter": 104, "verses": [{"chapter": 104, "verse": 1, "text": "وَيْلٞ لِّكُلِّ هُمَزَةٖ لُّمَزَةٍ", "number_in_hafs": [1]}, {"chapter": 104, "verse": 2, "text": "اِ۬لذِے جَمَعَ مَالاٗ وَعَدَّدَهُۥ", "number_in_hafs": [2]}, {"chapter": 104, "verse": 3, "text": "يَحْسِبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ", "number_in_hafs": [3]}, {"chapter": 104, "verse": 4, "text": "كَلَّاۖ لَيُنۢبَذَنَّ فِے اِ۬لْحُطَمَةِۖ", "number_in_hafs": [4]}, {"chapter": 104, "verse": 5, "text": "وَمَآ أَدْر۪يٰكَ مَا اَ۬لْحُطَمَةُۖ", "number_in_hafs": [5]}, {"chapter": 104, "verse": 6, "text": "نَارُ اُ۬للَّهِ اِ۬لْمُوقَدَةُ", "number_in_hafs": [6]}, {"chapter": 104, "verse": 7, "text": "اُ۬لتِے تَطَّلِعُ عَلَى اَ۬لَافْـِٕدَةِۖ", "number_in_hafs": [7]}, {"chapter": 104, "verse": 8, "text": "إِنَّهَا عَلَيْهِم مُّوصَدَةٞ", "number_in_hafs": [8]}, {"chapter": 104, "verse": 9, "text": "فِے عَمَدٖ مُّمَدَّدَةٍۖ", "number_in_hafs": [9]}]}