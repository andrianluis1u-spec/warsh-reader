{"chapter": 80, "verses": [{"chapter": 80, "verse": 1, "text": "عَبَسَ وَتَوَلّ۪ىٰٓ", "number_in_hafs": [1]}, {"chapter": 80, "verse": 2, "text": "أَن جَآءَهُ اُ۬لَاعْم۪ىٰۖ", "number_in_hafs": [2]}, {"chapter": 80, "verse": 3, "text": "وَمَا يُدْرِيكَۖ لَعَلَّهُۥ يَزَّكّ۪ىٰٓ", "number_in_hafs": [3]}, {"chapter": 80, "verse": 4, "text": "أَوْ يَذَّكَّرُ فَتَنفَعُهُ اُ۬لذِّكْر۪ىٰٓۖ", "number_in_hafs": [4]}, {"chapter": 80, "verse": 5, "text": "أَمَّا مَنِ اِ۪سْتَغْن۪ىٰ", "number_in_hafs": [5]}, {"chapter": 80, "verse": 6, "text": "فَأَنتَ لَهُۥ تَصَّدّ۪ىٰ", "number_in_hafs": [6]}, {"chapter": 80, "verse": 7, "text": "وَمَا عَلَيْكَ أَلَّا يَزَّكّ۪ىٰۖ", "number_in_hafs": [7]}, {"chapter": 80, "verse": 8, "text": "وَأَمَّا مَن جَآءَكَ يَسْع۪ىٰ", "number_in_hafs": [8]}, {"chapter": 80, "verse": 9, "text": "وَهُوَ يَخْش۪ىٰ", "number_in_hafs": [9]}, {"chapter": 80, "verse": 10, "text": "فَأَنتَ عَنْهُ تَلَهّ۪ىٰ", "number_in_hafs": [10]}, {"chapter": 80, "verse": 11, "text": "كَلَّآۖ إِنَّهَا تَذْكِرَةٞۖ", "number_in_hafs": [11]}, {"chapter": 80, "verse": 12, "text": "فَمَن شَآءَ ذَكَرَهُۥ", "number_in_hafs": [12]}, {"chapter": 80, "verse": 13, "text": "فِے صُحُفٖ مُّكَرَّمَةٖ", "number_in_hafs": [13]}, {"chapter": 80, "verse": 14, "text": "مَّرْفُوعَةٖ مُّطَهَّرَةِۢ", "number_in_hafs": [14]}, {"chapter": 80, "verse": 15, "text": "بِأَيْدِے سَفَرَةٖ", "number_in_hafs": [15]}, {"chapter": 80, "verse": 16, "text": "كِرَامِۢ بَرَرَةٖۖ", "number_in_hafs": [16]}, {"chapter": 80, "verse": 17, "text": "قُتِلَ اَ۬لِانسَٰنُ مَآ أَكْفَرَهُۥۖ", "number_in_hafs": [17]}, {"chapter": 80, "verse": 18, "text": "مِنَ اَيِّ شَےْءٍ خَلَقَهُۥۖ", "number_in_hafs": [18]}, {"chapter": 80, "verse": 19, "text": "مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ", "number_in_hafs": [19]}, {"chapter": 80, "verse": 20, "text": "ثُمَّ اَ۬لسَّبِيلَ يَسَّرَهُۥ", "number_in_hafs": [20]}, {"chapter": 80, "verse": 21, "text": "ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥۖ", "number_in_hafs": [21]}, {"chapter": 80, "verse": 22, "text": "ثُمَّ إِذَا شَآءَ انشَرَهُۥۖ", "number_in_hafs": [22]}, {"chapter": 80, "verse": 23, "text": "كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥۖ", "number_in_hafs": [23]}, {"chapter": 80, "verse": 24, "text": "فَلْيَنظُرِ اِ۬لِانسَٰنُ إِلَىٰ طَعَامِهِۦٓۖ", "number_in_hafs": [24]}, {"chapter": 80, "verse": 25, "text": "إِنَّا صَبَبْنَا اَ۬لْمَآءَ صَبّاٗ", "number_in_hafs": [25]}, {"chapter": 80, "verse": 26, "text": "ثُمَّ شَقَقْنَا اَ۬لَارْضَ شَقّاٗ", "number_in_hafs": [26]}, {"chapter": 80, "verse": 27, "text": "فَأَنۢبَتْنَا فِيهَا حَبّاٗ", "number_in_hafs": [27]}, {"chapter": 80, "verse": 28, "text": "وَعِنَباٗ وَقَضْباٗ", "number_in_hafs": [28]}, {"chapter": 80, "verse": 29, "text": "وَزَيْتُوناٗ وَنَخْلاٗ", "number_in_hafs": [29]}, {"chapter": 80, "verse": 30, "text": "وَحَدَآئِقَ غُلْباٗ", "number_in_hafs": [30]}, {"chapter": 80, "verse": 31, "text": "وَفَٰكِهَةٗ وَأَبّاٗ", "number_in_hafs": [31]}, {"chapter": 80, "verse": 32, "text": "مَّتَٰعاٗ لَّكُمْ وَلِأَنْعَٰمِكُمْۖ", "number_in_hafs": [32]}, {"chapter": 80, "verse": 33, "text": "فَإِذَا جَآءَتِ اِ۬لصَّآخَّةُ", "number_in_hafs": [33]}, {"chapter": 80, "verse": 34, "text": "يَوْمَ يَفِرُّ اُ۬لْمَرْءُ مِنَ اَخِيهِ", "number_in_hafs": [34]}, {"chapter": 80, "verse": 35, "text": "وَأُمِّهِۦ وَأَبِيهِ", "number_in_hafs": [35]}, {"chapter": 80, "verse": 36, "text": "وَصَٰحِبَتِهِۦ وَبَنِيهِۖ", "number_in_hafs": [36]}, {"chapter": 80, "verse": 37, "text": "لِكُلِّ اِ۪مْرِےٕٖ مِّنْهُمْ يَوْمَئِذٖ شَأْنٞ يُغْنِيهِۖ", "number_in_hafs": [37]}, {"chapter": 80, "verse": 38, "text": "وُجُوهٞ يَوْمَئِذٖ مُّسْفِرَةٞ", "number_in_hafs": [38]}, {"chapter": 80, "verse": 39, "text": "ضَاحِكَةٞ مُّسْتَبْشِرَةٞۖ", "number_in_hafs": [39]}, {"chapter": 80, "verse": 40, "text": "وَوُجُوهٞ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٞ", "number_in_hafs": [40]}, {"chapter": 80, "verse": 41, "text": "تَرْهَقُهَا قَتَرَةٌۖ", "number_in_hafs": [41]}, {"chapter": 80, "verse": 42, "text": "ا۟وْلَٰٓئِكَ هُمُ اُ۬لْكَفَرَةُ اُ۬لْفَجَرَةُۖ", "number_in_hafs": [42]}]}