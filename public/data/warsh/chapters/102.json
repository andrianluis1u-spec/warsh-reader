{"chapter": 102, "verses": [{"chapter": 102, "verse": 1, "text": "اَلْه۪يٰكُمُ اُ۬لتَّكَاثُرُ", "number_in_hafs": [1]}, {"chapter": 102, "verse": 2, "text": "حَتَّىٰ زُرْتُمُ اُ۬لْمَقَابِرَۖ", "number_in_hafs": [2]}, {"chapter": 102, "verse": 3, "text": "كَلَّا سَوْفَ تَعْلَمُونَ", "number_in_hafs": [3]}, {"chapter": 102, "verse": 4, "text": "ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَۖ", "number_in_hafs": [4]}, {"chapter": 102, "verse": 5, "text": "كَلَّا لَوْ تَعْلَمُونَ عِلْمَ اَ۬لْيَقِينِۖ", "number_in_hafs": [5]}, {"chapter": 102, "verse": 6, "text": "لَتَرَوُنَّ اَ۬لْجَحِيمَ", "number_in_hafs": [6]}, {"chapter": 102, "verse": 7, "text": "ثُمَّ لَتَرَوُنَّهَا عَيْنَ اَ۬لْيَقِينِ", "number_in_hafs": [7]}, {"chapter": 102, "verse": 8, "text": "ثُمَّ لَتُسْــَٔلُنَّ يَوْمَئِذٍ عَنِ اِ۬لنَّعِيمِۖ", "number_in_hafs": [8]}]}