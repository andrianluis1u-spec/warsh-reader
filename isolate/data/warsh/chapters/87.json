{"chapter": 87, "verses": [{"chapter": 87, "verse": 1, "text": "سَبِّحِ اِ۪سْمَ رَبِّكَ اَ۬لَاعْلَي", "number_in_hafs": [1]}, {"chapter": 87, "verse": 2, "text": "اَ۬لذِے خَلَقَ فَسَوّ۪ىٰ", "number_in_hafs": [2]}, {"chapter": 87, "verse": 3, "text": "وَالذِے قَدَّرَ فَهَد۪ىٰ", "number_in_hafs": [3]}, {"chapter": 87, "verse": 4, "text": "وَالذِےٓ أَخْرَجَ اَ۬لْمَرْع۪ىٰ", "number_in_hafs": [4]}, {"chapter": 87, "verse": 5, "text": "فَجَعَلَهُۥ غُثَآءً اَحْو۪ىٰۖ", "number_in_hafs": [5]}, {"chapter": 87, "verse": 6, "text": "سَنُقْرِيـُٔكَ فَلَا تَنس۪ىٰٓ", "number_in_hafs": [6]}, {"chapter": 87, "verse": 7, "text": "إِلَّا مَا شَآءَ اَ۬للَّهُۖ إِنَّهُۥ يَعْلَمُ اُ۬لْجَهْرَ وَمَا يَخْف۪ىٰۖ", "number_in_hafs": [7]}, {"chapter": 87, "verse": 8, "text": "وَنُيَسِّرُكَ لِلْيُسْر۪ىٰۖ", "number_in_hafs": [8]}, {"chapter": 87, "verse": 9, "text": "فَذَكِّرِ اِن نَّفَعَتِ اِ۬لذِّكْر۪ىٰۖ", "number_in_hafs": [9]}, {"chapter": 87, "verse": 10, "text": "سَيَذَّكَّرُ مَنْ يَّخْش۪ىٰ", "number_in_hafs": [10]}, {"chapter": 87, "verse": 11, "text": "وَيَتَجَنَّبُهَا اَ۬لَاشْقَي", "number_in_hafs": [11]}, {"chapter": 87, "verse": 12, "text": "اَ۬لذِے يَصْلَى اَ۬لنَّارَ اَ۬لْكُبْر۪ىٰ", "number_in_hafs": [12]}, {"chapter": 87, "verse": 13, "text": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْي۪ىٰۖ", "number_in_hafs": [13]}, {"chapter": 87, "verse": 14, "text": "قَدَ اَفْلَحَ مَن تَزَكّ۪ىٰ", "number_in_hafs": [14]}, {"chapter": 87, "verse": 15, "text": "وَذَكَرَ اَ۪سْمَ رَبِّهِۦ فَصَلّ۪ىٰۖ", "number_in_hafs": [15]}, {"chapter": 87, "verse": 16, "text": "بَلْ تُوثِرُونَ اَ۬لْحَيَوٰةَ اَ۬لدُّنْي۪ا", "number_in_hafs": [16]}, {"chapter": 87, "verse": 17, "text": "وَالَاخِرَةُ خَيْرٞ وَأَبْق۪ىٰٓۖ", "number_in_hafs": [17]}, {"chapter": 87, "verse": 18, "text": "إِنَّ هَٰذَا لَفِے اِ۬لصُّحُفِ اِ۬لُاول۪ىٰ", "number_in_hafs": [18]}, {"chapter": 87, "verse": 19, "text": "صُحُفِ إِبْرَٰهِيمَ وَمُوس۪ىٰۖ", "number_in_hafs": [19]}]}