{"chapter": 1, "verses": [{"chapter": 1, "verse": 1, "text": "اِ۬لْحَمْدُ لِلهِ رَبِّ اِ۬لْعَٰلَمِينَ", "number_in_hafs": [1, 2]}, {"chapter": 1, "verse": 2, "text": "اَ۬لرَّحْمَٰنِ اِ۬لرَّحِيمِ", "number_in_hafs": [3]}, {"chapter": 1, "verse": 3, "text": "مَلِكِ يَوْمِ اِ۬لدِّينِۖ", "number_in_hafs": [4]}, {"chapter": 1, "verse": 4, "text": "إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُۖ", "number_in_hafs": [5]}, {"chapter": 1, "verse": 5, "text": "اُ۪هْدِنَا اَ۬لصِّرَٰطَ اَ۬لْمُسْتَقِيمَ", "number_in_hafs": [6]}, {"chapter": 1, "verse": 6, "text": "صِرَٰطَ اَ۬لذِينَ أَنْعَمْتَ عَلَيْهِمْ", "number_in_hafs": [7]}, {"chapter": 1, "verse": 7, "text": "غَيْرِ اِ۬لْمَغْضُوبِ عَلَيْهِمْ وَلَا اَ۬لضَّآلِّينَۖ", "number_in_hafs": [7]}]}