{"chapter": 96, "verses": [{"chapter": 96, "verse": 1, "text": "اَ۪قْرَأْ بِاسْمِ رَبِّكَ اَ۬لذِے خَلَقَۖ", "number_in_hafs": [1]}, {"chapter": 96, "verse": 2, "text": "خَلَقَ اَ۬لِانسَٰنَ مِنْ عَلَقٍۖ", "number_in_hafs": [2]}, {"chapter": 96, "verse": 3, "text": "اِ۪قْرَأْ وَرَبُّكَ اَ۬لَاكْرَمُ", "number_in_hafs": [3]}, {"chapter": 96, "verse": 4, "text": "اُ۬لذِے عَلَّمَ بِالْقَلَمِ", "number_in_hafs": [4]}, {"chapter": 96, "verse": 5, "text": "عَلَّمَ اَ۬لِانسَٰنَ مَا لَمْ يَعْلَمْۖ", "number_in_hafs": [5]}, {"chapter": 96, "verse": 6, "text": "كَلَّآ إِنَّ اَ۬لِانسَٰنَ لَيَطْغ۪ىٰٓ", "number_in_hafs": [6]}, {"chapter": 96, "verse": 7, "text": "أَن رّ۪ء۪اهُ اُ۪سْتَغْن۪ىٰٓۖ", "number_in_hafs": [7]}, {"chapter": 96, "verse": 8, "text": "إِنَّ إِلَىٰ رَبِّكَ اَ۬لرُّجْع۪ىٰٓۖ", "number_in_hafs": [8]}, {"chapter": 96, "verse": 9, "text": "أَرَٰٓيْتَ اَ۬لذِے يَنْه۪ىٰ", "number_in_hafs": [9]}, {"chapter": 96, "verse": 10, "text": "عَبْداً اِذَا صَلّ۪ىٰٓۖ", "number_in_hafs": [10]}, {"chapter": 96, "verse": 11, "text": "أَرَٰٓيْتَ إِن كَانَ عَلَى اَ۬لْهُد۪ىٰٓ", "number_in_hafs": [11]}, {"chapter": 96, "verse": 12, "text": "أَوَ اَمَرَ بِالتَّقْو۪ىٰٓۖ", "number_in_hafs": [12]}, {"chapter": 96, "verse": 13, "text": "أَرَٰٓيْتَ إِن كَذَّبَ وَتَوَلّ۪ىٰٓ", "number_in_hafs": [13]}, {"chapter": 96, "verse": 14, "text": "أَلَمْ يَعْلَم بِأَنَّ اَ۬للَّهَ يَر۪ىٰۖ", "number_in_hafs": [14]}, {"chapter": 96, "verse": 15, "text": "كَلَّا لَئِن لَّمْ يَنتَهِ", "number_in_hafs": [15]}, {"chapter": 96, "verse": 16, "text": "لَنَسْفَعاَۢ بِالنَّاصِيَةِ", "number_in_hafs": [15]}, {"chapter": 96, "verse": 17, "text": "نَاصِيَةٖ كَٰذِبَةٍ خَاطِيـَٔةٖۖ", "number_in_hafs": [16]}, {"chapter": 96, "verse": 18, "text": "فَلْيَدْعُ نَادِيَهُۥ", "number_in_hafs": [17]}, {"chapter": 96, "verse": 19, "text": "سَنَدْعُ اُ۬لزَّبَانِيَةَۖ", "number_in_hafs": [18]}, {"chapter": 96, "verse": 20, "text": "كَلَّا لَا تُطِعْهُ وَاسْجُدْ وَاقْتَرِبِۖ۩", "number_in_hafs": [19]}]}