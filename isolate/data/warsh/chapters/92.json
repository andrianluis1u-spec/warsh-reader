{"chapter": 92, "verses": [{"chapter": 92, "verse": 1, "text": "وَاليْلِ إِذَا يَغْش۪ىٰ", "number_in_hafs": [1]}, {"chapter": 92, "verse": 2, "text": "وَالنَّه۪ارِ إِذَا تَجَلّ۪ىٰ", "number_in_hafs": [2]}, {"chapter": 92, "verse": 3, "text": "وَمَا خَلَقَ اَ۬لذَّكَرَ وَالُانث۪ىٰٓ", "number_in_hafs": [3]}, {"chapter": 92, "verse": 4, "text": "إِنَّ سَعْيَكُمْ لَشَتّ۪ىٰۖ", "number_in_hafs": [4]}, {"chapter": 92, "verse": 5, "text": "فَأَمَّا مَنَ اَعْط۪ىٰ وَاتَّق۪ىٰ", "number_in_hafs": [5]}, {"chapter": 92, "verse": 6, "text": "وَصَدَّقَ بِالْحُسْن۪ىٰ", "number_in_hafs": [6]}, {"chapter": 92, "verse": 7, "text": "فَسَنُيَسِّرُهُۥ لِلْيُسْر۪ىٰۖ", "number_in_hafs": [7]}, {"chapter": 92, "verse": 8, "text": "وَأَمَّا مَنۢ بَخِلَ وَاسْتَغْن۪ىٰ", "number_in_hafs": [8]}, {"chapter": 92, "verse": 9, "text": "وَكَذَّبَ بِالْحُسْن۪ىٰ", "number_in_hafs": [9]}, {"chapter": 92, "verse": 10, "text": "فَسَنُيَسِّرُهُۥ لِلْعُسْر۪ىٰۖ", "number_in_hafs": [10]}, {"chapter": 92, "verse": 11, "text": "وَمَا يُغْنِے عَنْهُ مَالُهُۥٓ إِذَا تَرَدّ۪ىٰٓۖ", "number_in_hafs": [11]}, {"chapter": 92, "verse": 12, "text": "إِنَّ عَلَيْنَا لَلْهُد۪ىٰ", "number_in_hafs": [12]}, {"chapter": 92, "verse": 13, "text": "وَإِنَّ لَنَا لَلَاخِرَةَ وَالُاول۪ىٰۖ", "number_in_hafs": [13]}, {"chapter": 92, "verse": 14, "text": "فَأَنذَرْتُكُمْ نَاراٗ تَلَظّ۪ىٰ", "number_in_hafs": [14]}, {"chapter": 92, "verse": 15, "text": "لَا يَصْلَيٰهَآ إِلَّا اَ۬لَاشْقَي", "number_in_hafs": [15]}, {"chapter": 92, "verse": 16, "text": "اَ۬لذِے كَذَّبَ وَتَوَلّ۪ىٰۖ", "number_in_hafs": [16]}, {"chapter": 92, "verse": 17, "text": "وَسَيُجَنَّبُهَا اَ۬لَاتْقَي", "number_in_hafs": [17]}, {"chapter": 92, "verse": 18, "text": "اَ۬لذِے يُوتِے مَالَهُۥ يَتَزَكّ۪ىٰۖ", "number_in_hafs": [18]}, {"chapter": 92, "verse": 19, "text": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٖ تُجْز۪ىٰٓ", "number_in_hafs": [19]}, {"chapter": 92, "verse": 20, "text": "إِلَّا اَ۪بْتِغَآءَ وَجْهِ رَبِّهِ اِ۬لَاعْل۪ىٰۖ", "number_in_hafs": [20]}, {"chapter": 92, "verse": 21, "text": "وَلَسَوْفَ يَرْض۪ىٰۖ", "number_in_hafs": [21]}]}