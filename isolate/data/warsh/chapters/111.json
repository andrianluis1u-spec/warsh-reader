{"chapter": 111, "verses": [{"chapter": 111, "verse": 1, "text": "تَبَّتْ يَدَآ أَبِے لَهَبٖ وَتَبَّۖ", "number_in_hafs": [1]}, {"chapter": 111, "verse": 2, "text": "مَآ أَغْن۪ىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَۖ", "number_in_hafs": [2]}, {"chapter": 111, "verse": 3, "text": "سَيَصْلَىٰ نَاراٗ ذَاتَ لَهَبٖ", "number_in_hafs": [3]}, {"chapter": 111, "verse": 4, "text": "وَامْرَأَتُهُۥۖ حَمَّالَةُ اُ۬لْحَطَبِ", "number_in_hafs": [4]}, {"chapter": 111, "verse": 5, "text": "فِے جِيدِهَا حَبْلٞ مِّن مَّسَدٖۖ", "number_in_hafs": [5]}]}