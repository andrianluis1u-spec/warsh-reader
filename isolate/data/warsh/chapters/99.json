{"chapter": 99, "verses": [{"chapter": 99, "verse": 1, "text": "إِذَا زُلْزِلَتِ اِ۬لَارْضُ زِلْزَالَهَا", "number_in_hafs": [1]}, {"chapter": 99, "verse": 2, "text": "وَأَخْرَجَتِ اِ۬لَارْضُ أَثْقَالَهَا", "number_in_hafs": [2]}, {"chapter": 99, "verse": 3, "text": "وَقَالَ اَ۬لِانسَٰنُ مَا لَهَا", "number_in_hafs": [3]}, {"chapter": 99, "verse": 4, "text": "يَوْمَئِذٖ تُحَدِّثُ أَخْبَارَهَا", "number_in_hafs": [4]}, {"chapter": 99, "verse": 5, "text": "بِأَنَّ رَبَّكَ أَوْح۪ىٰ لَهَاۖ", "number_in_hafs": [5]}, {"chapter": 99, "verse": 6, "text": "يَوْمَئِذٖ يَصْدُرُ اُ۬لنَّاسُ أَشْتَاتاٗ", "number_in_hafs": [6]}, {"chapter": 99, "verse": 7, "text": "لِّيُرَوَاْ اَعْمَٰلَهُمْۖ", "number_in_hafs": [6]}, {"chapter": 99, "verse": 8, "text": "فَمَنْ يَّعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْراٗ يَرَهُۥۖ", "number_in_hafs": [7]}, {"chapter": 99, "verse": 9, "text": "وَمَنْ يَّعْمَلْ مِثْقَالَ ذَرَّةٖ شَرّاٗ يَرَهُۥۖ", "number_in_hafs": [8]}]}