{"chapter": 78, "verses": [{"chapter": 78, "verse": 1, "text": "عَمَّۖ يَتَسَآءَلُونَ", "number_in_hafs": [1]}, {"chapter": 78, "verse": 2, "text": "عَنِ اِ۬لنَّبَإِ اِ۬لْعَظِيمِ", "number_in_hafs": [2]}, {"chapter": 78, "verse": 3, "text": "اِ۬لذِے هُمْ فِيهِ مُخْتَلِفُونَۖ", "number_in_hafs": [3]}, {"chapter": 78, "verse": 4, "text": "كَلَّا سَيَعْلَمُونَ", "number_in_hafs": [4]}, {"chapter": 78, "verse": 5, "text": "ثُمَّ كَلَّا سَيَعْلَمُونَۖ", "number_in_hafs": [5]}, {"chapter": 78, "verse": 6, "text": "أَلَمْ نَجْعَلِ اِ۬لَارْضَ مِهَٰداٗ", "number_in_hafs": [6]}, {"chapter": 78, "verse": 7, "text": "وَالْجِبَالَ أَوْتَاداٗ", "number_in_hafs": [7]}, {"chapter": 78, "verse": 8, "text": "وَخَلَقْنَٰكُمُۥٓ أَزْوَٰجاٗ", "number_in_hafs": [8]}, {"chapter": 78, "verse": 9, "text": "وَجَعَلْنَا نَوْمَكُمْ سُبَاتاٗ", "number_in_hafs": [9]}, {"chapter": 78, "verse": 10, "text": "وَجَعَلْنَا اَ۬ليْلَ لِبَاساٗ", "number_in_hafs": [10]}, {"chapter": 78, "verse": 11, "text": "وَجَعَلْنَا اَ۬لنَّهَارَ مَعَاشاٗ", "number_in_hafs": [11]}, {"chapter": 78, "verse": 12, "text": "وَبَنَيْنَا فَوْقَكُمْ سَبْعاٗ شِدَاداٗ", "number_in_hafs": [12]}, {"chapter": 78, "verse": 13, "text": "وَجَعَلْنَا سِرَاجاٗ وَهَّاجاٗ", "number_in_hafs": [13]}, {"chapter": 78, "verse": 14, "text": "وَأَنزَلْنَا مِنَ اَ۬لْمُعْصِرَٰتِ مَآءٗ ثَجَّاجاٗ", "number_in_hafs": [14]}, {"chapter": 78, "verse": 15, "text": "لِّنُخْرِجَ بِهِۦ حَبّاٗ وَنَبَاتاٗ", "number_in_hafs": [15]}, {"chapter": 78, "verse": 16, "text": "وَجَنَّٰتٍ اَلْفَافاًۖ", "number_in_hafs": [16]}, {"chapter": 78, "verse": 17, "text": "اِنَّ يَوْمَ اَ۬لْفَصْلِ كَانَ مِيقَٰتاٗ", "number_in_hafs": [17]}, {"chapter": 78, "verse": 18, "text": "يَوْمَ يُنفَخُ فِے اِ۬لصُّورِ فَتَاتُونَ أَفْوَاجاٗ", "number_in_hafs": [18]}, {"chapter": 78, "verse": 19, "text": "وَفُتِّحَتِ اِ۬لسَّمَآءُ فَكَانَتَ اَبْوَٰباٗ", "number_in_hafs": [19]}, {"chapter": 78, "verse": 20, "text": "وَسُيِّرَتِ اِ۬لْجِبَالُ فَكَانَتْ سَرَاباًۖ", "number_in_hafs": [20]}, {"chapter": 78, "verse": 21, "text": "اِنَّ جَهَنَّمَ كَانَتْ مِرْصَاداٗ", "number_in_hafs": [21]}, {"chapter": 78, "verse": 22, "text": "لِّلطَّٰغِينَ مَــَٔاباٗ", "number_in_hafs": [22]}, {"chapter": 78, "verse": 23, "text": "لَّٰبِثِينَ فِيهَآ أَحْقَاباٗۖ", "number_in_hafs": [23]}, {"chapter": 78, "verse": 24, "text": "لَّا يَذُوقُونَ فِيهَا بَرْداٗ وَلَا شَرَاباً", "number_in_hafs": [24]}, {"chapter": 78, "verse": 25, "text": "اِلَّا حَمِيماٗ وَغَسَاقاٗ", "number_in_hafs": [25]}, {"chapter": 78, "verse": 26, "text": "جَزَآءٗ وِفَاقاًۖ", "number_in_hafs": [26]}, {"chapter": 78, "verse": 27, "text": "اِنَّهُمْ كَانُواْ لَا يَرْجُونَ حِسَاباٗ", "number_in_hafs": [27]}, {"chapter": 78, "verse": 28, "text": "وَكَذَّبُواْ بِــَٔايَٰتِنَا كِذَّاباٗۖ", "number_in_hafs": [28]}, {"chapter": 78, "verse": 29, "text": "وَكُلَّ شَےْءٍ اَحْصَيْنَٰهُ كِتَٰباٗۖ", "number_in_hafs": [29]}, {"chapter": 78, "verse": 30, "text": "فَذُوقُواْ فَلَن نَّزِيدَكُمُۥٓ إِلَّا عَذَاباًۖ", "number_in_hafs": [30]}, {"chapter": 78, "verse": 31, "text": "اِنَّ لِلْمُتَّقِينَ مَفَازاً", "number_in_hafs": [31]}, {"chapter": 78, "verse": 32, "text": "حَدَآئِقَ وَأَعْنَٰباٗ", "number_in_hafs": [32]}, {"chapter": 78, "verse": 33, "text": "وَكَوَاعِبَ أَتْرَاباٗ", "number_in_hafs": [33]}, {"chapter": 78, "verse": 34, "text": "وَكَأْساٗ دِهَاقاٗ", "number_in_hafs": [34]}, {"chapter": 78, "verse": 35, "text": "لَّا يَسْمَعُونَ فِيهَا لَغْواٗ وَلَا كِذَّاباٗۖ", "number_in_hafs": [35]}, {"chapter": 78, "verse": 36, "text": "جَزَآءٗ مِّن رَّبِّكَ عَطَآءً حِسَاباٗۖ", "number_in_hafs": [36]}, {"chapter": 78, "verse": 37, "text": "رَّبُّ اُ۬لسَّمَٰوَٰتِ وَالَارْضِ وَمَا بَيْنَهُمَاۖ اَ۬لرَّحْمَٰنُ لَا يَمْلِكُونَ مِنْهُ خِطَاباٗۖ", "number_in_hafs": [37]}, {"chapter": 78, "verse": 38, "text": "يَوْمَ يَقُومُ اُ۬لرُّوحُ وَالْمَلَٰٓئِكَةُ صَفّاٗ لَّا يَتَكَلَّمُونَ إِلَّا مَنَ اَذِنَ لَهُ اُ۬لرَّحْمَٰنُ وَقَالَ صَوَاباٗۖ", "number_in_hafs": [38]}, {"chapter": 78, "verse": 39, "text": "ذَٰلِكَ اَ۬لْيَوْمُ اُ۬لْحَقُّۖ فَمَن شَآءَ اَ۪تَّخَذَ إِلَىٰ رَبِّهِۦ مَــَٔاباًۖ", "number_in_hafs": [39]}, {"chapter": 78, "verse": 40, "text": "اِنَّآ أَنذَرْنَٰكُمْ عَذَاباٗ قَرِيباٗ يَوْمَ يَنظُرُ اُ۬لْمَرْءُ مَا قَدَّمَتْ يَدَٰهُ وَيَقُولُ اُ۬لْكَافِرُ يَٰلَيْتَنِے كُنتُ تُرَٰباٗۖ", "number_in_hafs": [40]}]}