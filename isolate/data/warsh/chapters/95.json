{"chapter": 95, "verses": [{"chapter": 95, "verse": 1, "text": "وَالتِّينِ وَالزَّيْتُونِ", "number_in_hafs": [1]}, {"chapter": 95, "verse": 2, "text": "وَطُورِ سِينِينَ", "number_in_hafs": [2]}, {"chapter": 95, "verse": 3, "text": "وَهَٰذَا اَ۬لْبَلَدِ اِ۬لَامِينِ", "number_in_hafs": [3]}, {"chapter": 95, "verse": 4, "text": "لَقَدْ خَلَقْنَا اَ۬لِانسَٰنَ فِےٓ أَحْسَنِ تَقْوِيمٖ", "number_in_hafs": [4]}, {"chapter": 95, "verse": 5, "text": "ثُمَّ رَدَدْنَٰهُ أَسْفَلَ سَٰفِلِينَ", "number_in_hafs": [5]}, {"chapter": 95, "verse": 6, "text": "إِلَّا اَ۬لذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ فَلَهُمُۥٓ أَجْرٌ غَيْرُ مَمْنُونٖۖ", "number_in_hafs": [6]}, {"chapter": 95, "verse": 7, "text": "فَمَا يُكَذِّبُكَ بَعْدُ بِالدِّينِۖ", "number_in_hafs": [7]}, {"chapter": 95, "verse": 8, "text": "أَلَيْسَ اَ۬للَّهُ بِأَحْكَمِ اِ۬لْحَٰكِمِينَۖ", "number_in_hafs": [8]}]}