{"chapter": 75, "verses": [{"chapter": 75, "verse": 1, "text": "لَآ أُقْسِمُ بِيَوْمِ اِ۬لْقِيَٰمَةِ", "number_in_hafs": [1]}, {"chapter": 75, "verse": 2, "text": "وَلَآ أُقْسِمُ بِالنَّفْسِ اِ۬للَّوَّامَةِۖ", "number_in_hafs": [2]}, {"chapter": 75, "verse": 3, "text": "أَيَحْسِبُ اُ۬لِانسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ", "number_in_hafs": [3]}, {"chapter": 75, "verse": 4, "text": "بَل۪ىٰۖ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّيَ بَنَانَهُۥۖ", "number_in_hafs": [4]}, {"chapter": 75, "verse": 5, "text": "بَلْ يُرِيدُ اُ۬لِانسَٰنُ لِيَفْجُرَ أَمَامَهُۥۖ", "number_in_hafs": [5]}, {"chapter": 75, "verse": 6, "text": "يَسْــَٔلُ أَيَّانَ يَوْمُ اُ۬لْقِيَٰمَةِۖ", "number_in_hafs": [6]}, {"chapter": 75, "verse": 7, "text": "فَإِذَا بَرَقَ اَ۬لْبَصَرُ", "number_in_hafs": [7]}, {"chapter": 75, "verse": 8, "text": "وَخَسَفَ اَ۬لْقَمَرُ", "number_in_hafs": [8]}, {"chapter": 75, "verse": 9, "text": "وَجُمِعَ اَ۬لشَّمْسُ وَالْقَمَرُ", "number_in_hafs": [9]}, {"chapter": 75, "verse": 10, "text": "يَقُولُ اُ۬لِانسَٰنُ يَوْمَئِذٍ اَيْنَ اَ۬لْمَفَرُّۖ", "number_in_hafs": [10]}, {"chapter": 75, "verse": 11, "text": "كَلَّا لَا وَزَرَۖ", "number_in_hafs": [11]}, {"chapter": 75, "verse": 12, "text": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ اِ۬لْمُسْتَقَرُّۖ", "number_in_hafs": [12]}, {"chapter": 75, "verse": 13, "text": "يُنَبَّؤُاْ اُ۬لِانسَٰنُ يَوْمَئِذِۢ بِمَا قَدَّمَ وَأَخَّرَۖ", "number_in_hafs": [13]}, {"chapter": 75, "verse": 14, "text": "بَلِ اِ۬لِانسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٞ", "number_in_hafs": [14]}, {"chapter": 75, "verse": 15, "text": "وَلَوَ اَلْق۪ىٰ مَعَاذِيرَهُۥۖ", "number_in_hafs": [15]}, {"chapter": 75, "verse": 16, "text": "لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓۖ إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥۖ", "number_in_hafs": [16, 17]}, {"chapter": 75, "verse": 17, "text": "فَإِذَا قَرَأْنَٰهُ فَاتَّبِعْ قُرْءَانَهُۥ", "number_in_hafs": [18]}, {"chapter": 75, "verse": 18, "text": "ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥۖ", "number_in_hafs": [19]}, {"chapter": 75, "verse": 19, "text": "كَلَّا بَلْ تُحِبُّونَ اَ۬لْعَاجِلَةَ", "number_in_hafs": [20]}, {"chapter": 75, "verse": 20, "text": "وَتَذَرُونَ اَ۬لَاخِرَةَۖ", "number_in_hafs": [21]}, {"chapter": 75, "verse": 21, "text": "وُجُوهٞ يَوْمَئِذٖ نَّاضِرَةٌ", "number_in_hafs": [22]}, {"chapter": 75, "verse": 22, "text": "اِلَىٰ رَبِّهَا نَاظِرَةٞۖ", "number_in_hafs": [23]}, {"chapter": 75, "verse": 23, "text": "وَوُجُوهٞ يَوْمَئِذِۢ بَاسِرَةٞ", "number_in_hafs": [24]}, {"chapter": 75, "verse": 24, "text": "تَظُنُّ أَنْ يُّفْعَلَ بِهَا فَاقِرَةٞۖ", "number_in_hafs": [25]}, {"chapter": 75, "verse": 25, "text": "كَلَّآ إِذَا بَلَغَتِ اِ۬لتَّرَاقِيَ", "number_in_hafs": [26]}, {"chapter": 75, "verse": 26, "text": "وَقِيلَ مَن رَّاقٖ", "number_in_hafs": [27]}, {"chapter": 75, "verse": 27, "text": "وَظَنَّ أَنَّهُ اُ۬لْفِرَاقُ", "number_in_hafs": [28]}, {"chapter": 75, "verse": 28, "text": "وَالْتَفَّتِ اِ۬لسَّاقُ بِالسَّاقِ", "number_in_hafs": [29]}, {"chapter": 75, "verse": 29, "text": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ اِ۬لْمَسَاقُۖ", "number_in_hafs": [30]}, {"chapter": 75, "verse": 30, "text": "فَلَا صَدَّقَ وَلَا صَلّ۪ىٰۖ", "number_in_hafs": [31]}, {"chapter": 75, "verse": 31, "text": "وَلَٰكِن كَذَّبَ وَتَوَلّ۪ىٰۖ", "number_in_hafs": [32]}, {"chapter": 75, "verse": 32, "text": "ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطّ۪ىٰٓۖ", "number_in_hafs": [33]}, {"chapter": 75, "verse": 33, "text": "أَوْل۪ىٰ لَكَ فَأَوْل۪ىٰ", "number_in_hafs": [34]}, {"chapter": 75, "verse": 34, "text": "ثُمَّ أَوْل۪ىٰ لَكَ فَأَوْل۪ىٰٓۖ", "number_in_hafs": [35]}, {"chapter": 75, "verse": 35, "text": "أَيَحْسِبُ اُ۬لِانسَٰنُ أَنْ يُّتْرَكَ سُدىًۖ", "number_in_hafs": [36]}, {"chapter": 75, "verse": 36, "text": "اَلَمْ يَكُ نُطْفَةٗ مِّن مَّنِيّٖ تُمْن۪ىٰ", "number_in_hafs": [37]}, {"chapter": 75, "verse": 37, "text": "ثُمَّ كَانَ عَلَقَةٗ فَخَلَقَ فَسَوّ۪ىٰ", "number_in_hafs": [38]}, {"chapter": 75, "verse": 38, "text": "فَجَعَلَ مِنْهُ اُ۬لزَّوْجَيْنِ اِ۬لذَّكَرَ وَالُانث۪ىٰٓۖ", "number_in_hafs": [39]}, {"chapter": 75, "verse": 39, "text": "أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَنْ يُّحْـِۧيَ اَ۬لْمَوْت۪ىٰۖ", "number_in_hafs": [40]}]}