{"chapter": 70, "verses": [{"chapter": 70, "verse": 1, "text": "سَالَ سَآئِلُۢ بِعَذَابٖ وَاقِعٖ", "number_in_hafs": [1]}, {"chapter": 70, "verse": 2, "text": "لِّلْكٰ۪فِرِينَ لَيْسَ لَهُۥ دَافِعٞ", "number_in_hafs": [2]}, {"chapter": 70, "verse": 3, "text": "مِّنَ اَ۬للَّهِ ذِے اِ۬لْمَعَارِجِۖ", "number_in_hafs": [3]}, {"chapter": 70, "verse": 4, "text": "تَعْرُجُ اُ۬لْمَلَٰٓئِكَةُ وَالرُّوحُ إِلَيْهِ فِے يَوْمٖ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٖۖ", "number_in_hafs": [4]}, {"chapter": 70, "verse": 5, "text": "فَاصْبِرْ صَبْراٗ جَمِيلاًۖ", "number_in_hafs": [5]}, {"chapter": 70, "verse": 6, "text": "اِنَّهُمْ يَرَوْنَهُۥ بَعِيداٗ", "number_in_hafs": [6]}, {"chapter": 70, "verse": 7, "text": "وَنَر۪يٰهُ قَرِيباٗۖ", "number_in_hafs": [7]}, {"chapter": 70, "verse": 8, "text": "يَوْمَ تَكُونُ اُ۬لسَّمَآءُ كَالْمُهْلِ", "number_in_hafs": [8]}, {"chapter": 70, "verse": 9, "text": "وَتَكُونُ اُ۬لْجِبَالُ كَالْعِهْنِ", "number_in_hafs": [9]}, {"chapter": 70, "verse": 10, "text": "وَلَا يَسْــَٔلُ حَمِيمٌ حَمِيماٗ", "number_in_hafs": [10]}, {"chapter": 70, "verse": 11, "text": "يُبَصَّرُونَهُمْۖ يَوَدُّ اُ۬لْمُجْرِمُ لَوْ يَفْتَدِے مِنْ عَذَابِ يَوْمَئِذِۢ بِبَنِيهِ", "number_in_hafs": [11]}, {"chapter": 70, "verse": 12, "text": "وَصَٰحِبَتِهِۦ وَأَخِيهِ", "number_in_hafs": [12]}, {"chapter": 70, "verse": 13, "text": "وَفَصِيلَتِهِ اِ۬لتِے تُــْٔوِيهِ", "number_in_hafs": [13]}, {"chapter": 70, "verse": 14, "text": "وَمَن فِے اِ۬لَارْضِ جَمِيعاٗ ثُمَّ يُنجِيهِ", "number_in_hafs": [14]}, {"chapter": 70, "verse": 15, "text": "كَلَّآۖ إِنَّهَا لَظ۪ىٰ", "number_in_hafs": [15]}, {"chapter": 70, "verse": 16, "text": "نَزَّاعَةٞ لِّلشَّو۪ىٰ", "number_in_hafs": [16]}, {"chapter": 70, "verse": 17, "text": "تَدْعُواْ مَنَ اَدْبَرَ وَتَوَلّ۪ىٰ", "number_in_hafs": [17]}, {"chapter": 70, "verse": 18, "text": "وَجَمَعَ فَأَوْع۪ىٰٓۖ", "number_in_hafs": [18]}, {"chapter": 70, "verse": 19, "text": "إِنَّ اَ۬لِانسَٰنَ خُلِقَ هَلُوعاً", "number_in_hafs": [19]}, {"chapter": 70, "verse": 20, "text": "اِذَا مَسَّهُ اُ۬لشَّرُّ جَزُوعاٗ", "number_in_hafs": [20]}, {"chapter": 70, "verse": 21, "text": "وَإِذَا مَسَّهُ اُ۬لْخَيْرُ مَنُوعاً", "number_in_hafs": [21]}, {"chapter": 70, "verse": 22, "text": "اِلَّا اَ۬لْمُصَلِّينَ", "number_in_hafs": [22]}, {"chapter": 70, "verse": 23, "text": "اَ۬لذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَۖ", "number_in_hafs": [23]}, {"chapter": 70, "verse": 24, "text": "وَالذِينَ فِےٓ أَمْوَٰلِهِمْ حَقّٞ مَّعْلُومٞ", "number_in_hafs": [24]}, {"chapter": 70, "verse": 25, "text": "لِّلسَّآئِلِ وَالْمَحْرُومِۖ", "number_in_hafs": [25]}, {"chapter": 70, "verse": 26, "text": "وَالذِينَ يُصَدِّقُونَ بِيَوْمِ اِ۬لدِّينِۖ", "number_in_hafs": [26]}, {"chapter": 70, "verse": 27, "text": "وَالذِينَ هُم مِّنْ عَذَابِ رَبِّهِم مُّشْفِقُونَ", "number_in_hafs": [27]}, {"chapter": 70, "verse": 28, "text": "إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَامُونٖۖ", "number_in_hafs": [28]}, {"chapter": 70, "verse": 29, "text": "وَالذِينَ هُمْ لِفُرُوجِهِمْ حَٰفِظُونَ", "number_in_hafs": [29]}, {"chapter": 70, "verse": 30, "text": "إِلَّا عَلَىٰٓ أَزْوَٰجِهِمُۥٓ أَوْ مَا مَلَكَتَ اَيْمَٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَۖ", "number_in_hafs": [30]}, {"chapter": 70, "verse": 31, "text": "فَمَنِ اِ۪بْتَغ۪ىٰ وَرَآءَ ذَٰلِكَ فَأُوْلَٰٓئِكَ هُمُ اُ۬لْعَادُونَۖ", "number_in_hafs": [31]}, {"chapter": 70, "verse": 32, "text": "وَالذِينَ هُمْ لِأَمَٰنَٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَۖ", "number_in_hafs": [32]}, {"chapter": 70, "verse": 33, "text": "وَالذِينَ هُم بِشَهَٰدَتِهِمْ قَآئِمُونَۖ", "number_in_hafs": [33]}, {"chapter": 70, "verse": 34, "text": "وَالذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ", "number_in_hafs": [34]}, {"chapter": 70, "verse": 35, "text": "أُوْلَٰٓئِكَ فِے جَنَّٰتٖ مُّكْرَمُونَۖ", "number_in_hafs": [35]}, {"chapter": 70, "verse": 36, "text": "فَمَالِ اِ۬لذِينَ كَفَرُواْ قِبَلَكَ مُهْطِعِينَ", "number_in_hafs": [36]}, {"chapter": 70, "verse": 37, "text": "عَنِ اِ۬لْيَمِينِ وَعَنِ اِ۬لشِّمَالِ عِزِينَۖ", "number_in_hafs": [37]}, {"chapter": 70, "verse": 38, "text": "أَيَطْمَعُ كُلُّ اُ۪مْرِےٕٖ مِّنْهُمُۥٓ أَنْ يُّدْخَلَ جَنَّةَ نَعِيمٖ", "number_in_hafs": [38]}, {"chapter": 70, "verse": 39, "text": "كَلَّآۖ إِنَّا خَلَقْنَٰهُم مِّمَّا يَعْلَمُونَۖ", "number_in_hafs": [39]}, {"chapter": 70, "verse": 40, "text": "۞ فَلَآ أُقْسِمُ بِرَبِّ اِ۬لْمَشَٰرِقِ وَالْمَغَٰرِبِ إِنَّا لَقَٰدِرُونَ", "number_in_hafs": [40]}, {"chapter": 70, "verse": 41, "text": "عَلَىٰٓ أَن نُّبَدِّلَ خَيْراٗ مِّنْهُمْ وَمَا نَحْنُ بِمَسْبُوقِينَۖ", "number_in_hafs": [41]}, {"chapter": 70, "verse": 42, "text": "فَذَرْهُمْ يَخُوضُواْ وَيَلْعَبُواْ حَتَّىٰ يُلَٰقُواْ يَوْمَهُمُ اُ۬لذِے يُوعَدُونَ", "number_in_hafs": [42]}, {"chapter": 70, "verse": 43, "text": "يَوْمَ يَخْرُجُونَ مِنَ اَ۬لَاجْدَاثِ سِرَاعاٗ كَأَنَّهُمُۥٓ إِلَىٰ نَصْبٖ يُوفِضُونَ", "number_in_hafs": [43]}, {"chapter": 70, "verse": 44, "text": "خَٰشِعَةً اَبْصَٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٞۖ ذَٰلِكَ اَ۬لْيَوْمُ اُ۬لذِے كَانُواْ يُوعَدُونَۖ", "number_in_hafs": [44]}]}