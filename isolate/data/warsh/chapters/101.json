{"chapter": 101, "verses": [{"chapter": 101, "verse": 1, "text": "اِ۬لْقَارِعَةُ مَا اَ۬لْقَارِعَةُۖ", "number_in_hafs": [1, 2]}, {"chapter": 101, "verse": 2, "text": "وَمَآ أَدْر۪يٰكَ مَا اَ۬لْقَارِعَةُۖ", "number_in_hafs": [3]}, {"chapter": 101, "verse": 3, "text": "يَوْمَ يَكُونُ اُ۬لنَّاسُ كَالْفَرَاشِ اِ۬لْمَبْثُوثِ", "number_in_hafs": [4]}, {"chapter": 101, "verse": 4, "text": "وَتَكُونُ اُ۬لْجِبَالُ كَالْعِهْنِ اِ۬لْمَنفُوشِۖ", "number_in_hafs": [5]}, {"chapter": 101, "verse": 5, "text": "فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ", "number_in_hafs": [6]}, {"chapter": 101, "verse": 6, "text": "فَهُوَ فِے عِيشَةٖ رَّاضِيَةٖۖ", "number_in_hafs": [7]}, {"chapter": 101, "verse": 7, "text": "وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ", "number_in_hafs": [8]}, {"chapter": 101, "verse": 8, "text": "فَأُمُّهُۥ هَاوِيَةٞۖ", "number_in_hafs": [9]}, {"chapter": 101, "verse": 9, "text": "وَمَآ أَدْر۪يٰكَ مَا هِيَهْۖ", "number_in_hafs": [10]}, {"chapter": 101, "verse": 10, "text": "نَارٌ حَامِيَةٌۖ", "number_in_hafs": [11]}]}