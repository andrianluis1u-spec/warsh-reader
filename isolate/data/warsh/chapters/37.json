{"chapter": 37, "verses": [{"chapter": 37, "verse": 1, "text": "وَالصَّٰٓفَّٰتِ صَفّاٗ", "number_in_hafs": [1]}, {"chapter": 37, "verse": 2, "text": "فَالزَّٰجِرَٰتِ زَجْراٗ", "number_in_hafs": [2]}, {"chapter": 37, "verse": 3, "text": "فَالتَّٰلِيَٰتِ ذِكْراً", "number_in_hafs": [3]}, {"chapter": 37, "verse": 4, "text": "اِنَّ إِلَٰهَكُمْ لَوَٰحِدٞۖ", "number_in_hafs": [4]}, {"chapter": 37, "verse": 5, "text": "رَّبُّ اُ۬لسَّمَٰوَٰتِ وَالَارْضِ وَمَا بَيْنَهُمَا وَرَبُّ اُ۬لْمَشَٰرِقِۖ", "number_in_hafs": [5]}, {"chapter": 37, "verse": 6, "text": "إِنَّا زَيَّنَّا اَ۬لسَّمَآءَ اَ۬لدُّنْي۪ا بِزِينَةِ اِ۬لْكَوَاكِبِۖ", "number_in_hafs": [6]}, {"chapter": 37, "verse": 7, "text": "وَحِفْظاٗ مِّن كُلِّ شَيْطَٰنٖ مَّارِدٖۖ", "number_in_hafs": [7]}, {"chapter": 37, "verse": 8, "text": "لَّا يَسْمَعُونَ إِلَى اَ۬لْمَلَإِ اِ۬لَاعْل۪ىٰ وَيُقْذَفُونَ مِن كُلِّ جَانِبٖۖ", "number_in_hafs": [8]}, {"chapter": 37, "verse": 9, "text": "دُحُوراٗۖ وَلَهُمْ عَذَابٞ وَاصِبٌ", "number_in_hafs": [9]}, {"chapter": 37, "verse": 10, "text": "اِلَّا مَنْ خَطِفَ اَ۬لْخَطْفَةَ فَأَتْبَعَهُۥ شِهَابٞ ثَاقِبٞۖ", "number_in_hafs": [10]}, {"chapter": 37, "verse": 11, "text": "فَاسْتَفْتِهِمُۥٓ أَهُمُۥٓ أَشَدُّ خَلْقاً اَم مَّنْ خَلَقْنَآۖ إِنَّا خَلَقْنَٰهُم مِّن طِينٖ لَّٰزِبِۢۖ", "number_in_hafs": [11]}, {"chapter": 37, "verse": 12, "text": "بَلْ عَجِبْتَ وَيَسْخَرُونَۖ", "number_in_hafs": [12]}, {"chapter": 37, "verse": 13, "text": "وَإِذَا ذُكِّرُواْ لَا يَذْكُرُونَۖ", "number_in_hafs": [13]}, {"chapter": 37, "verse": 14, "text": "وَإِذَا رَأَوَاْ اٰيَةٗ يَسْتَسْخِرُونَۖ", "number_in_hafs": [14]}, {"chapter": 37, "verse": 15, "text": "وَقَالُوٓاْ إِنْ هَٰذَآ إِلَّا سِحْرٞ مُّبِينٌ", "number_in_hafs": [15]}, {"chapter": 37, "verse": 16, "text": "اَ۟ذَا مِتْنَا وَكُنَّا تُرَاباٗ وَعِظَٰماً اِنَّا لَمَبْعُوثُونَ", "number_in_hafs": [16]}, {"chapter": 37, "verse": 17, "text": "أَوَءَابَآؤُنَا اَ۬لَاوَّلُونَۖ", "number_in_hafs": [17]}, {"chapter": 37, "verse": 18, "text": "قُلْ نَعَمْ وَأَنتُمْ دَٰخِرُونَۖ", "number_in_hafs": [18]}, {"chapter": 37, "verse": 19, "text": "فَإِنَّمَا هِيَ زَجْرَةٞ وَٰحِدَةٞ فَإِذَا هُمْ يَنظُرُونَۖ", "number_in_hafs": [19]}, {"chapter": 37, "verse": 20, "text": "وَقَالُواْ يَٰوَيْلَنَا هَٰذَا يَوْمُ اُ۬لدِّينِۖ", "number_in_hafs": [20]}, {"chapter": 37, "verse": 21, "text": "هَٰذَا يَوْمُ اُ۬لْفَصْلِ اِ۬لذِے كُنتُم بِهِۦ تُكَذِّبُونَۖ", "number_in_hafs": [21]}, {"chapter": 37, "verse": 22, "text": "۞ اَ۟حْشُرُواْ اُ۬لذِينَ ظَلَمُواْ وَأَزْوَٰجَهُمْ وَمَا كَانُواْ يَعْبُدُونَ", "number_in_hafs": [22]}, {"chapter": 37, "verse": 23, "text": "مِن دُونِ اِ۬للَّهِ فَاهْدُوهُمُۥٓ إِلَىٰ صِرَٰطِ اِ۬لْجَحِيمِۖ", "number_in_hafs": [23]}, {"chapter": 37, "verse": 24, "text": "وَقِفُوهُمُۥٓ إِنَّهُم مَّسْــُٔولُونَۖ", "number_in_hafs": [24]}, {"chapter": 37, "verse": 25, "text": "مَا لَكُمْ لَا تَنَاصَرُونَۖ", "number_in_hafs": [25]}, {"chapter": 37, "verse": 26, "text": "بَلْ هُمُ اُ۬لْيَوْمَ مُسْتَسْلِمُونَۖ", "number_in_hafs": [26]}, {"chapter": 37, "verse": 27, "text": "وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٖ يَتَسَآءَلُونَۖ", "number_in_hafs": [27]}, {"chapter": 37, "verse": 28, "text": "قَالُوٓاْ إِنَّكُمْ كُنتُمْ تَاتُونَنَا عَنِ اِ۬لْيَمِينِۖ", "number_in_hafs": [28]}, {"chapter": 37, "verse": 29, "text": "قَالُواْ بَل لَّمْ تَكُونُواْ مُومِنِينَۖ", "number_in_hafs": [29]}, {"chapter": 37, "verse": 30, "text": "وَمَا كَانَ لَنَا عَلَيْكُم مِّن سُلْطَٰنِۢ بَلْ كُنتُمْ قَوْماٗ طَٰغِينَۖ", "number_in_hafs": [30]}, {"chapter": 37, "verse": 31, "text": "فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَآ إِنَّا لَذَآئِقُونَ", "number_in_hafs": [31]}, {"chapter": 37, "verse": 32, "text": "فَأَغْوَيْنَٰكُمُۥٓ إِنَّا كُنَّا غَٰوِينَۖ", "number_in_hafs": [32]}, {"chapter": 37, "verse": 33, "text": "فَإِنَّهُمْ يَوْمَئِذٖ فِے اِ۬لْعَذَابِ مُشْتَرِكُونَۖ", "number_in_hafs": [33]}, {"chapter": 37, "verse": 34, "text": "إِنَّا كَذَٰلِكَ نَفْعَلُ بِالْمُجْرِمِينَۖ", "number_in_hafs": [34]}, {"chapter": 37, "verse": 35, "text": "إِنَّهُمْ كَانُوٓاْ إِذَا قِيلَ لَهُمْ لَآ إِلَٰهَ إِلَّا اَ۬للَّهُ يَسْتَكْبِرُونَ", "number_in_hafs": [35]}, {"chapter": 37, "verse": 36, "text": "وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓاْ ءَالِهَتِنَا لِشَاعِرٖ مَّجْنُونِۢۖ", "number_in_hafs": [36]}, {"chapter": 37, "verse": 37, "text": "بَلْ جَآءَ بِالْحَقِّ وَصَدَّقَ اَ۬لْمُرْسَلِينَۖ", "number_in_hafs": [37]}, {"chapter": 37, "verse": 38, "text": "إِنَّكُمْ لَذَآئِقُواْ اُ۬لْعَذَابِ اِ۬لَالِيمِۖ", "number_in_hafs": [38]}, {"chapter": 37, "verse": 39, "text": "وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ", "number_in_hafs": [39]}, {"chapter": 37, "verse": 40, "text": "إِلَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ", "number_in_hafs": [40]}, {"chapter": 37, "verse": 41, "text": "أُوْلَٰٓئِكَ لَهُمْ رِزْقٞ مَّعْلُومٞ", "number_in_hafs": [41]}, {"chapter": 37, "verse": 42, "text": "فَوَٰكِهُۖ وَهُم مُّكْرَمُونَ", "number_in_hafs": [42]}, {"chapter": 37, "verse": 43, "text": "فِے جَنَّٰتِ اِ۬لنَّعِيمِ", "number_in_hafs": [43]}, {"chapter": 37, "verse": 44, "text": "عَلَىٰ سُرُرٖ مُّتَقَٰبِلِينَۖ", "number_in_hafs": [44]}, {"chapter": 37, "verse": 45, "text": "يُطَافُ عَلَيْهِم بِكَأْسٖ مِّن مَّعِينِۢ", "number_in_hafs": [45]}, {"chapter": 37, "verse": 46, "text": "بَيْضَآءَ لَذَّةٖ لِّلشَّٰرِبِينَ", "number_in_hafs": [46]}, {"chapter": 37, "verse": 47, "text": "لَا فِيهَا غَوْلٞ وَلَا هُمْ عَنْهَا يُنزَفُونَۖ", "number_in_hafs": [47]}, {"chapter": 37, "verse": 48, "text": "وَعِندَهُمْ قَٰصِرَٰتُ اُ۬لطَّرْفِ عِينٞ", "number_in_hafs": [48]}, {"chapter": 37, "verse": 49, "text": "كَأَنَّهُنَّ بَيْضٞ مَّكْنُونٞۖ", "number_in_hafs": [49]}, {"chapter": 37, "verse": 50, "text": "فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٖ يَتَسَآءَلُونَۖ", "number_in_hafs": [50]}, {"chapter": 37, "verse": 51, "text": "۞ قَالَ قَآئِلٞ مِّنْهُمُۥٓ إِنِّے كَانَ لِے قَرِينٞ", "number_in_hafs": [51]}, {"chapter": 37, "verse": 52, "text": "يَقُولُ أَ۟نَّكَ لَمِنَ اَ۬لْمُصَدِّقِينَ", "number_in_hafs": [52]}, {"chapter": 37, "verse": 53, "text": "أَ۟ذَا مِتْنَا وَكُنَّا تُرَاباٗ وَعِظَٰماً اِنَّا لَمَدِينُونَۖ", "number_in_hafs": [53]}, {"chapter": 37, "verse": 54, "text": "قَالَ هَلَ اَنتُم مُّطَّلِعُونَ", "number_in_hafs": [54]}, {"chapter": 37, "verse": 55, "text": "فَاطَّلَعَ فَر۪ء۪اهُ فِے سَوَآءِ اِ۬لْجَحِيمِۖ", "number_in_hafs": [55]}, {"chapter": 37, "verse": 56, "text": "قَالَ تَاللَّهِ إِن كِدتَّ لَتُرْدِينِۦ", "number_in_hafs": [56]}, {"chapter": 37, "verse": 57, "text": "وَلَوْلَا نِعْمَةُ رَبِّے لَكُنتُ مِنَ اَ۬لْمُحْضَرِينَۖ", "number_in_hafs": [57]}, {"chapter": 37, "verse": 58, "text": "أَفَمَا نَحْنُ بِمَيِّتِينَ", "number_in_hafs": [58]}, {"chapter": 37, "verse": 59, "text": "إِلَّا مَوْتَتَنَا اَ۬لُاول۪ىٰ وَمَا نَحْنُ بِمُعَذَّبِينَۖ", "number_in_hafs": [59]}, {"chapter": 37, "verse": 60, "text": "إِنَّ هَٰذَا لَهُوَ اَ۬لْفَوْزُ اُ۬لْعَظِيمُۖ", "number_in_hafs": [60]}, {"chapter": 37, "verse": 61, "text": "لِمِثْلِ هَٰذَا فَلْيَعْمَلِ اِ۬لْعَٰمِلُونَۖ", "number_in_hafs": [61]}, {"chapter": 37, "verse": 62, "text": "أَذَٰلِكَ خَيْرٞ نُّزُلاً اَمْ شَجَرَةُ اُ۬لزَّقُّومِۖ", "number_in_hafs": [62]}, {"chapter": 37, "verse": 63, "text": "إِنَّا جَعَلْنَٰهَا فِتْنَةٗ لِّلظَّٰلِمِينَۖ", "number_in_hafs": [63]}, {"chapter": 37, "verse": 64, "text": "إِنَّهَا شَجَرَةٞ تَخْرُجُ فِےٓ أَصْلِ اِ۬لْجَحِيمِ", "number_in_hafs": [64]}, {"chapter": 37, "verse": 65, "text": "طَلْعُهَا كَأَنَّهُۥ رُءُوسُ اُ۬لشَّيَٰطِينِۖ", "number_in_hafs": [65]}, {"chapter": 37, "verse": 66, "text": "فَإِنَّهُمْ لَأٓكِلُونَ مِنْهَا فَمَالِــُٔونَ مِنْهَا اَ۬لْبُطُونَ", "number_in_hafs": [66]}, {"chapter": 37, "verse": 67, "text": "ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْباٗ مِّنْ حَمِيمٖۖ", "number_in_hafs": [67]}, {"chapter": 37, "verse": 68, "text": "ثُمَّ إِنَّ مَرْجِعَهُمْ لَإِلَى اَ۬لْجَحِيمِۖ", "number_in_hafs": [68]}, {"chapter": 37, "verse": 69, "text": "إِنَّهُمُۥٓ أَلْفَوَاْ اٰبَآءَهُمْ ضَآلِّينَ", "number_in_hafs": [69]}, {"chapter": 37, "verse": 70, "text": "فَهُمْ عَلَىٰٓ ءَاثٰ۪رِهِمْ يُهْرَعُونَۖ", "number_in_hafs": [70]}, {"chapter": 37, "verse": 71, "text": "وَلَقَد ضَّلَّ قَبْلَهُمُۥٓ أَكْثَرُ اُ۬لَاوَّلِينَۖ", "number_in_hafs": [71]}, {"chapter": 37, "verse": 72, "text": "وَلَقَدَ اَرْسَلْنَا فِيهِم مُّنذِرِينَۖ", "number_in_hafs": [72]}, {"chapter": 37, "verse": 73, "text": "فَانظُرْ كَيْفَ كَانَ عَٰقِبَةُ اُ۬لْمُنذَرِينَ", "number_in_hafs": [73]}, {"chapter": 37, "verse": 74, "text": "إِلَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ", "number_in_hafs": [74]}, {"chapter": 37, "verse": 75, "text": "وَلَقَدْ نَاد۪يٰنَا نُوحٞۖ فَلَنِعْمَ اَ۬لْمُجِيبُونَۖ", "number_in_hafs": [75]}, {"chapter": 37, "verse": 76, "text": "وَنَجَّيْنَٰهُ وَأَهْلَهُۥ مِنَ اَ۬لْكَرْبِ اِ۬لْعَظِيمِۖ", "number_in_hafs": [76]}, {"chapter": 37, "verse": 77, "text": "وَجَعَلْنَا ذُرِّيَّتَهُۥ هُمُ اُ۬لْبَاقِينَۖ", "number_in_hafs": [77]}, {"chapter": 37, "verse": 78, "text": "وَتَرَكْنَا عَلَيْهِ فِے اِ۬لَاخِرِينَۖ", "number_in_hafs": [78]}, {"chapter": 37, "verse": 79, "text": "سَلَٰمٌ عَلَىٰ نُوحٖ فِے اِ۬لْعَٰلَمِينَۖ", "number_in_hafs": [79]}, {"chapter": 37, "verse": 80, "text": "إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ", "number_in_hafs": [80]}, {"chapter": 37, "verse": 81, "text": "إِنَّهُۥ مِنْ عِبَادِنَا اَ۬لْمُومِنِينَۖ", "number_in_hafs": [81]}, {"chapter": 37, "verse": 82, "text": "ثُمَّ أَغْرَقْنَا اَ۬لَاخَرِينَۖ", "number_in_hafs": [82]}, {"chapter": 37, "verse": 83, "text": "۞ وَإِنَّ مِن شِيعَتِهِۦ لَإِبْرَٰهِيمَ", "number_in_hafs": [83]}, {"chapter": 37, "verse": 84, "text": "إِذْ جَآءَ رَبَّهُۥ بِقَلْبٖ سَلِيمٍ", "number_in_hafs": [84]}, {"chapter": 37, "verse": 85, "text": "اِذْ قَالَ لِأَبِيهِ وَقَوْمِهِۦ مَاذَا تَعْبُدُونَۖ", "number_in_hafs": [85]}, {"chapter": 37, "verse": 86, "text": "أَئِفْكاً اٰلِهَةٗ دُونَ اَ۬للَّهِ تُرِيدُونَۖ", "number_in_hafs": [86]}, {"chapter": 37, "verse": 87, "text": "فَمَا ظَنُّكُم بِرَبِّ اِ۬لْعَٰلَمِينَۖ", "number_in_hafs": [87]}, {"chapter": 37, "verse": 88, "text": "فَنَظَرَ نَظْرَةٗ فِے اِ۬لنُّجُومِ", "number_in_hafs": [88]}, {"chapter": 37, "verse": 89, "text": "فَقَالَ إِنِّے سَقِيمٞ", "number_in_hafs": [89]}, {"chapter": 37, "verse": 90, "text": "فَتَوَلَّوْاْ عَنْهُ مُدْبِرِينَۖ", "number_in_hafs": [90]}, {"chapter": 37, "verse": 91, "text": "فَرَاغَ إِلَىٰٓ ءَالِهَتِهِمْ فَقَالَ أَلَا تَاكُلُونَ", "number_in_hafs": [91]}, {"chapter": 37, "verse": 92, "text": "مَا لَكُمْ لَا تَنطِقُونَۖ", "number_in_hafs": [92]}, {"chapter": 37, "verse": 93, "text": "فَرَاغَ عَلَيْهِمْ ضَرْباَۢ بِالْيَمِينِ", "number_in_hafs": [93]}, {"chapter": 37, "verse": 94, "text": "فَأَقْبَلُوٓاْ إِلَيْهِ يَزِفُّونَۖ", "number_in_hafs": [94]}, {"chapter": 37, "verse": 95, "text": "قَالَ أَتَعْبُدُونَ مَا تَنْحِتُونَ", "number_in_hafs": [95]}, {"chapter": 37, "verse": 96, "text": "وَاللَّهُ خَلَقَكُمْ وَمَا تَعْمَلُونَۖ", "number_in_hafs": [96]}, {"chapter": 37, "verse": 97, "text": "قَالُواْ اُ۪بْنُواْ لَهُۥ بُنْيَٰناٗ فَأَلْقُوهُ فِے اِ۬لْجَحِيمِ", "number_in_hafs": [97]}, {"chapter": 37, "verse": 98, "text": "فَأَرَادُواْ بِهِۦ كَيْداٗ فَجَعَلْنَٰهُمُ اُ۬لَاسْفَلِينَۖ", "number_in_hafs": [98]}, {"chapter": 37, "verse": 99, "text": "وَقَالَ إِنِّے ذَاهِبٌ اِلَىٰ رَبِّے سَيَهْدِينِۖ", "number_in_hafs": [99]}, {"chapter": 37, "verse": 100, "text": "رَبِّ هَبْ لِے مِنَ اَ۬لصَّٰلِحِينَۖ", "number_in_hafs": [100]}, {"chapter": 37, "verse": 101, "text": "فَبَشَّرْنَٰهُ بِغُلَٰمٍ حَلِيمٖۖ", "number_in_hafs": [101]}, {"chapter": 37, "verse": 102, "text": "فَلَمَّا بَلَغَ مَعَهُ اُ۬لسَّعْيَ قَالَ يَٰبُنَيِّ إِنِّيَ أَر۪ىٰ فِے اِ۬لْمَنَامِ أَنِّيَ أَذْبَحُكَ فَانظُرْ مَاذَا تَر۪ىٰۖ قَالَ يَٰٓأَبَتِ اِ۪فْعَلْ مَا تُومَرُۖ سَتَجِدُنِيَ إِن شَآءَ اَ۬للَّهُ مِنَ اَ۬لصَّٰبِرِينَۖ", "number_in_hafs": [102]}, {"chapter": 37, "verse": 103, "text": "فَلَمَّآ أَسْلَمَا وَتَلَّهُۥ لِلْجَبِينِ", "number_in_hafs": [103]}, {"chapter": 37, "verse": 104, "text": "وَنَٰدَيْنَٰهُ أَنْ يَّٰٓإِبْرَٰهِيمُ", "number_in_hafs": [104]}, {"chapter": 37, "verse": 105, "text": "قَدْ صَدَّقْتَ اَ۬لرُّءْي۪آۖ إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ", "number_in_hafs": [105]}, {"chapter": 37, "verse": 106, "text": "إِنَّ هَٰذَا لَهُوَ اَ۬لْبَلَٰٓؤُاْ اُ۬لْمُبِينُۖ", "number_in_hafs": [106]}, {"chapter": 37, "verse": 107, "text": "وَفَدَيْنَٰهُ بِذِبْحٍ عَظِيمٖۖ", "number_in_hafs": [107]}, {"chapter": 37, "verse": 108, "text": "وَتَرَكْنَا عَلَيْهِ فِے اِ۬لَاخِرِينَۖ", "number_in_hafs": [108]}, {"chapter": 37, "verse": 109, "text": "سَلَٰمٌ عَلَىٰٓ إِبْرَٰهِيمَۖ", "number_in_hafs": [109]}, {"chapter": 37, "verse": 110, "text": "كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ", "number_in_hafs": [110]}, {"chapter": 37, "verse": 111, "text": "إِنَّهُۥ مِنْ عِبَادِنَا اَ۬لْمُومِنِينَۖ", "number_in_hafs": [111]}, {"chapter": 37, "verse": 112, "text": "وَبَشَّرْنَٰهُ بِإِسْحَٰقَ نَبِيٓــٔاٗ مِّنَ اَ۬لصَّٰلِحِينَ", "number_in_hafs": [112]}, {"chapter": 37, "verse": 113, "text": "وَبَٰرَكْنَا عَلَيْهِ وَعَلَىٰٓ إِسْحَٰقَۖ وَمِن ذُرِّيَّتِهِمَا مُحْسِنٞ وَظَالِمٞ لِّنَفْسِهِۦ مُبِينٞۖ", "number_in_hafs": [113]}, {"chapter": 37, "verse": 114, "text": "۞ وَلَقَدْ مَنَنَّا عَلَىٰ مُوس۪ىٰ وَهَٰرُونَ", "number_in_hafs": [114]}, {"chapter": 37, "verse": 115, "text": "وَنَجَّيْنَٰهُمَا وَقَوْمَهُمَا مِنَ اَ۬لْكَرْبِ اِ۬لْعَظِيمِۖ", "number_in_hafs": [115]}, {"chapter": 37, "verse": 116, "text": "وَنَصَرْنَٰهُمْ فَكَانُواْ هُمُ اُ۬لْغَٰلِبِينَۖ", "number_in_hafs": [116]}, {"chapter": 37, "verse": 117, "text": "وَءَاتَيْنَٰهُمَا اَ۬لْكِتَٰبَ اَ۬لْمُسْتَبِينَۖ", "number_in_hafs": [117]}, {"chapter": 37, "verse": 118, "text": "وَهَدَيْنَٰهُمَا اَ۬لصِّرَٰطَ اَ۬لْمُسْتَقِيمَۖ", "number_in_hafs": [118]}, {"chapter": 37, "verse": 119, "text": "وَتَرَكْنَا عَلَيْهِمَا فِے اِ۬لَاخِرِينَۖ", "number_in_hafs": [119]}, {"chapter": 37, "verse": 120, "text": "سَلَٰمٌ عَلَىٰ مُوس۪ىٰ وَهَٰرُونَۖ", "number_in_hafs": [120]}, {"chapter": 37, "verse": 121, "text": "إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ", "number_in_hafs": [121]}, {"chapter": 37, "verse": 122, "text": "إِنَّهُمَا مِنْ عِبَادِنَا اَ۬لْمُومِنِينَۖ", "number_in_hafs": [122]}, {"chapter": 37, "verse": 123, "text": "وَإِنَّ إِلْيَاسَ لَمِنَ اَ۬لْمُرْسَلِينَ", "number_in_hafs": [123]}, {"chapter": 37, "verse": 124, "text": "إِذْ قَالَ لِقَوْمِهِۦٓ أَلَا تَتَّقُونَ", "number_in_hafs": [124]}, {"chapter": 37, "verse": 125, "text": "أَتَدْعُونَ بَعْلاٗ وَتَذَرُونَ أَحْسَنَ اَ۬لْخَٰلِقِينَۖ", "number_in_hafs": [125]}, {"chapter": 37, "verse": 126, "text": "اَ۬للَّهُ رَبُّكُمْ وَرَبُّ ءَابَآئِكُمُ اُ۬لَاوَّلِينَۖ", "number_in_hafs": [126]}, {"chapter": 37, "verse": 127, "text": "فَكَذَّبُوهُ فَإِنَّهُمْ لَمُحْضَرُونَ", "number_in_hafs": [127]}, {"chapter": 37, "verse": 128, "text": "إِلَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ", "number_in_hafs": [128]}, {"chapter": 37, "verse": 129, "text": "وَتَرَكْنَا عَلَيْهِ فِے اِ۬لَاخِرِينَۖ", "number_in_hafs": [129]}, {"chapter": 37, "verse": 130, "text": "سَلَٰمٌ عَلَىٰٓ ءَالِ يَاسِينَۖ", "number_in_hafs": [130]}, {"chapter": 37, "verse": 131, "text": "إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ", "number_in_hafs": [131]}, {"chapter": 37, "verse": 132, "text": "إِنَّهُۥ مِنْ عِبَادِنَا اَ۬لْمُومِنِينَۖ", "number_in_hafs": [132]}, {"chapter": 37, "verse": 133, "text": "وَإِنَّ لُوطاٗ لَّمِنَ اَ۬لْمُرْسَلِينَ", "number_in_hafs": [133]}, {"chapter": 37, "verse": 134, "text": "إِذْ نَجَّيْنَٰهُ وَأَهْلَهُۥٓ أَجْمَعِينَ", "number_in_hafs": [134]}, {"chapter": 37, "verse": 135, "text": "إِلَّا عَجُوزاٗ فِے اِ۬لْغَٰبِرِينَ", "number_in_hafs": [135]}, {"chapter": 37, "verse": 136, "text": "ثُمَّ دَمَّرْنَا اَ۬لَاخَرِينَۖ", "number_in_hafs": [136]}, {"chapter": 37, "verse": 137, "text": "وَإِنَّكُمْ لَتَمُرُّونَ عَلَيْهِم مُّصْبِحِينَ", "number_in_hafs": [137]}, {"chapter": 37, "verse": 138, "text": "وَبِاليْلِۖ أَفَلَا تَعْقِلُونَۖ", "number_in_hafs": [138]}, {"chapter": 37, "verse": 139, "text": "وَإِنَّ يُونُسَ لَمِنَ اَ۬لْمُرْسَلِينَ", "number_in_hafs": [139]}, {"chapter": 37, "verse": 140, "text": "إِذَ اَبَقَ إِلَى اَ۬لْفُلْكِ اِ۬لْمَشْحُونِ", "number_in_hafs": [140]}, {"chapter": 37, "verse": 141, "text": "فَسَاهَمَ فَكَانَ مِنَ اَ۬لْمُدْحَضِينَ", "number_in_hafs": [141]}, {"chapter": 37, "verse": 142, "text": "فَالْتَقَمَهُ اُ۬لْحُوتُ وَهُوَ مُلِيمٞۖ", "number_in_hafs": [142]}, {"chapter": 37, "verse": 143, "text": "فَلَوْلَآ أَنَّهُۥ كَانَ مِنَ اَ۬لْمُسَبِّحِينَ", "number_in_hafs": [143]}, {"chapter": 37, "verse": 144, "text": "لَلَبِثَ فِے بَطْنِهِۦٓ إِلَىٰ يَوْمِ يُبْعَثُونَۖ", "number_in_hafs": [144]}, {"chapter": 37, "verse": 145, "text": "۞ فَنَبَذْنَٰهُ بِالْعَرَآءِ وَهُوَ سَقِيمٞۖ", "number_in_hafs": [145]}, {"chapter": 37, "verse": 146, "text": "وَأَنۢبَتْنَا عَلَيْهِ شَجَرَةٗ مِّنْ يَّقْطِينٖۖ", "number_in_hafs": [146]}, {"chapter": 37, "verse": 147, "text": "وَأَرْسَلْنَٰهُ إِلَىٰ مِاْيـَٔةِ أَلْفٍ اَوْ يَزِيدُونَۖ", "number_in_hafs": [147]}, {"chapter": 37, "verse": 148, "text": "فَــَٔامَنُواْ فَمَتَّعْنَٰهُمُۥٓ إِلَىٰ حِينٖۖ", "number_in_hafs": [148]}, {"chapter": 37, "verse": 149, "text": "فَاسْتَفْتِهِمُۥٓ أَلِرَبِّكَ اَ۬لْبَنَاتُ وَلَهُمُ اُ۬لْبَنُونَۖ", "number_in_hafs": [149]}, {"chapter": 37, "verse": 150, "text": "أَمْ خَلَقْنَا اَ۬لْمَلَٰٓئِكَةَ إِنَٰثاٗ وَهُمْ شَٰهِدُونَۖ", "number_in_hafs": [150]}, {"chapter": 37, "verse": 151, "text": "أَلَآ إِنَّهُم مِّنِ اِفْكِهِمْ لَيَقُولُونَ", "number_in_hafs": [151]}, {"chapter": 37, "verse": 152, "text": "وَلَدَ اَ۬للَّهُ وَإِنَّهُمْ لَكَٰذِبُونَۖ", "number_in_hafs": [152]}, {"chapter": 37, "verse": 153, "text": "أَصْطَفَى اَ۬لْبَنَاتِ عَلَى اَ۬لْبَنِينَۖ", "number_in_hafs": [153]}, {"chapter": 37, "verse": 154, "text": "مَا لَكُمْۖ كَيْفَ تَحْكُمُونَۖ", "number_in_hafs": [154]}, {"chapter": 37, "verse": 155, "text": "أَفَلَا تَذَّكَّرُونَۖ", "number_in_hafs": [155]}, {"chapter": 37, "verse": 156, "text": "أَمْ لَكُمْ سُلْطَٰنٞ مُّبِينٞ", "number_in_hafs": [156]}, {"chapter": 37, "verse": 157, "text": "فَاتُواْ بِكِتَٰبِكُمُۥٓ إِن كُنتُمْ صَٰدِقِينَۖ", "number_in_hafs": [157]}, {"chapter": 37, "verse": 158, "text": "وَجَعَلُواْ بَيْنَهُۥ وَبَيْنَ اَ۬لْجِنَّةِ نَسَباٗۖ وَلَقَدْ عَلِمَتِ اِ۬لْجِنَّةُ إِنَّهُمْ لَمُحْضَرُونَۖ", "number_in_hafs": [158]}, {"chapter": 37, "verse": 159, "text": "سُبْحَٰنَ اَ۬للَّهِ عَمَّا يَصِفُونَۖ", "number_in_hafs": [159]}, {"chapter": 37, "verse": 160, "text": "إِلَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ", "number_in_hafs": [160]}, {"chapter": 37, "verse": 161, "text": "فَإِنَّكُمْ وَمَا تَعْبُدُونَ", "number_in_hafs": [161]}, {"chapter": 37, "verse": 162, "text": "مَآ أَنتُمْ عَلَيْهِ بِفَٰتِنِينَ", "number_in_hafs": [162]}, {"chapter": 37, "verse": 163, "text": "إِلَّا مَنْ هُوَ صَالِ اِ۬لْجَحِيمِۖ", "number_in_hafs": [163]}, {"chapter": 37, "verse": 164, "text": "وَمَا مِنَّآ إِلَّا لَهُۥ مَقَامٞ مَّعْلُومٞۖ", "number_in_hafs": [164]}, {"chapter": 37, "verse": 165, "text": "وَإِنَّا لَنَحْنُ اُ۬لصَّآفُّونَ", "number_in_hafs": [165]}, {"chapter": 37, "verse": 166, "text": "وَإِنَّا لَنَحْنُ اُ۬لْمُسَبِّحُونَۖ", "number_in_hafs": [166]}, {"chapter": 37, "verse": 167, "text": "وَإِن كَانُواْ لَيَقُولُونَ", "number_in_hafs": [167]}, {"chapter": 37, "verse": 168, "text": "لَوَ اَنَّ عِندَنَا ذِكْراٗ مِّنَ اَ۬لَاوَّلِينَ", "number_in_hafs": [168]}, {"chapter": 37, "verse": 169, "text": "لَكُنَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ", "number_in_hafs": [169]}, {"chapter": 37, "verse": 170, "text": "فَكَفَرُواْ بِهِۦۖ فَسَوْفَ يَعْلَمُونَۖ", "number_in_hafs": [170]}, {"chapter": 37, "verse": 171, "text": "وَلَقَدْ سَبَقَتْ كَلِمَتُنَا لِعِبَادِنَا اَ۬لْمُرْسَلِينَ", "number_in_hafs": [171]}, {"chapter": 37, "verse": 172, "text": "إِنَّهُمْ لَهُمُ اُ۬لْمَنصُورُونَ", "number_in_hafs": [172]}, {"chapter": 37, "verse": 173, "text": "وَإِنَّ جُندَنَا لَهُمُ اُ۬لْغَٰلِبُونَۖ", "number_in_hafs": [173]}, {"chapter": 37, "verse": 174, "text": "فَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٖۖ", "number_in_hafs": [174]}, {"chapter": 37, "verse": 175, "text": "وَأَبْصِرْهُمْ فَسَوْفَ يُبْصِرُونَۖ", "number_in_hafs": [175]}, {"chapter": 37, "verse": 176, "text": "أَفَبِعَذَابِنَا يَسْتَعْجِلُونَۖ", "number_in_hafs": [176]}, {"chapter": 37, "verse": 177, "text": "فَإِذَا نَزَلَ بِسَاحَتِهِمْ فَسَآءَ صَبَاحُ اُ۬لْمُنذَرِينَۖ", "number_in_hafs": [177]}, {"chapter": 37, "verse": 178, "text": "وَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٖۖ", "number_in_hafs": [178]}, {"chapter": 37, "verse": 179, "text": "وَأَبْصِرْ فَسَوْفَ يُبْصِرُونَۖ", "number_in_hafs": [179]}, {"chapter": 37, "verse": 180, "text": "سُبْحَٰنَ رَبِّكَ رَبِّ اِ۬لْعِزَّةِ عَمَّا يَصِفُونَۖ", "number_in_hafs": [180]}, {"chapter": 37, "verse": 181, "text": "وَسَلَٰمٌ عَلَى اَ۬لْمُرْسَلِينَۖ", "number_in_hafs": [181]}, {"chapter": 37, "verse": 182, "text": "وَالْحَمْدُ لِلهِ رَبِّ اِ۬لْعَٰلَمِينَۖ", "number_in_hafs": [182]}]}