{"chapter": 88, "verses": [{"chapter": 88, "verse": 1, "text": "هَلَ اَت۪يٰكَ حَدِيثُ اُ۬لْغَٰشِيَةِۖ", "number_in_hafs": [1]}, {"chapter": 88, "verse": 2, "text": "وُجُوهٞ يَوْمَئِذٍ خَٰشِعَةٌ", "number_in_hafs": [2]}, {"chapter": 88, "verse": 3, "text": "عَامِلَةٞ نَّاصِبَةٞ", "number_in_hafs": [3]}, {"chapter": 88, "verse": 4, "text": "تَصْلَىٰ نَاراً حَامِيَةٗ", "number_in_hafs": [4]}, {"chapter": 88, "verse": 5, "text": "تُسْق۪ىٰ مِنْ عَيْنٍ اٰنِيَةٖۖ", "number_in_hafs": [5]}, {"chapter": 88, "verse": 6, "text": "لَّيْسَ لَهُمْ طَعَامٌ اِلَّا مِن ضَرِيعٖ", "number_in_hafs": [6]}, {"chapter": 88, "verse": 7, "text": "لَّا يُسْمِنُ وَلَا يُغْنِے مِن جُوعٖۖ", "number_in_hafs": [7]}, {"chapter": 88, "verse": 8, "text": "وُجُوهٞ يَوْمَئِذٖ نَّاعِمَةٞ", "number_in_hafs": [8]}, {"chapter": 88, "verse": 9, "text": "لِّسَعْيِهَا رَاضِيَةٞ", "number_in_hafs": [9]}, {"chapter": 88, "verse": 10, "text": "فِے جَنَّةٍ عَالِيَةٖ", "number_in_hafs": [10]}, {"chapter": 88, "verse": 11, "text": "لَّا تُسْمَعُ فِيهَا لَٰغِيَةٞۖ", "number_in_hafs": [11]}, {"chapter": 88, "verse": 12, "text": "فِيهَا عَيْنٞ جَارِيَةٞۖ", "number_in_hafs": [12]}, {"chapter": 88, "verse": 13, "text": "فِيهَا سُرُرٞ مَّرْفُوعَةٞ", "number_in_hafs": [13]}, {"chapter": 88, "verse": 14, "text": "وَأَكْوَابٞ مَّوْضُوعَةٞ", "number_in_hafs": [14]}, {"chapter": 88, "verse": 15, "text": "وَنَمَارِقُ مَصْفُوفَةٞ", "number_in_hafs": [15]}, {"chapter": 88, "verse": 16, "text": "وَزَرَابِيُّ مَبْثُوثَةٌۖ", "number_in_hafs": [16]}, {"chapter": 88, "verse": 17, "text": "۞ اَفَلَا يَنظُرُونَ إِلَى اَ۬لِابِلِ كَيْفَ خُلِقَتْ", "number_in_hafs": [17]}, {"chapter": 88, "verse": 18, "text": "وَإِلَى اَ۬لسَّمَآءِ كَيْفَ رُفِعَتْ", "number_in_hafs": [18]}, {"chapter": 88, "verse": 19, "text": "وَإِلَى اَ۬لْجِبَالِ كَيْفَ نُصِبَتْ", "number_in_hafs": [19]}, {"chapter": 88, "verse": 20, "text": "وَإِلَى اَ۬لَارْضِ كَيْفَ سُطِحَتْۖ", "number_in_hafs": [20]}, {"chapter": 88, "verse": 21, "text": "فَذَكِّرِ اِنَّمَآ أَنتَ مُذَكِّرٞۖ", "number_in_hafs": [21]}, {"chapter": 88, "verse": 22, "text": "لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍۖ", "number_in_hafs": [22]}, {"chapter": 88, "verse": 23, "text": "اِلَّا مَن تَوَلّ۪ىٰ وَكَفَرَ", "number_in_hafs": [23]}, {"chapter": 88, "verse": 24, "text": "فَيُعَذِّبُهُ اُ۬للَّهُ اُ۬لْعَذَابَ اَ۬لَاكْبَرَۖ", "number_in_hafs": [24]}, {"chapter": 88, "verse": 25, "text": "إِنَّ إِلَيْنَآ إِيَابَهُمْ", "number_in_hafs": [25]}, {"chapter": 88, "verse": 26, "text": "ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُمْۖ", "number_in_hafs": [26]}]}