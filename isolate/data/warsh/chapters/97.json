{"chapter": 97, "verses": [{"chapter": 97, "verse": 1, "text": "اِنَّآ أَنزَلْنَٰهُ فِے لَيْلَةِ اِ۬لْقَدْرِۖ", "number_in_hafs": [1]}, {"chapter": 97, "verse": 2, "text": "وَمَآ أَدْر۪يٰكَ مَا لَيْلَةُ اُ۬لْقَدْرِۖ", "number_in_hafs": [2]}, {"chapter": 97, "verse": 3, "text": "لَيْلَةُ اُ۬لْقَدْرِ خَيْرٞ مِّنَ اَلْفِ شَهْرٖۖ", "number_in_hafs": [3]}, {"chapter": 97, "verse": 4, "text": "تَنَزَّلُ اُ۬لْمَلَٰٓئِكَةُ وَالرُّوحُ فِيهَا بِإِذْنِ رَبِّهِم مِّن كُلِّ أَمْرٖۖ", "number_in_hafs": [4]}, {"chapter": 97, "verse": 5, "text": "سَلَٰمٌ هِيَ حَتَّىٰ مَطْلَعِ اِ۬لْفَجْرِۖ", "number_in_hafs": [5]}]}